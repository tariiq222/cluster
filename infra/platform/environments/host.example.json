{
  "contract_version": "1.0.0",
  "environment": "staging",
  "host": {
    "id": "replace-with-approved-host-id",
    "owner": "replace-with-approved-owner",
    "data_root": "/srv/cluster",
    "minimum_free_gib": 40,
    "timezone": "Asia/Riyadh"
  },
  "public_endpoint": {
    "origin": "https://cluster.example.invalid",
    "ports": [443]
  },
  "management": {
    "origin": "https://dokploy.example.invalid",
    "health_path": "/api/health",
    "allowed_cidrs": ["10.0.0.0/24"],
    "ports": [22, 443]
  },
  "registry": {
    "hostname": "registry.example.invalid",
    "port": 443,
    "repository": "third-health-cluster/platform"
  },
  "dokploy": {
    "project": "replace-with-approved-project",
    "compose_name": "cluster",
    "probe_path": "/api/read-only/project-identity",
    "project_json_pointer": "/project/name",
    "compose_json_pointer": "/project/compose_name"
  },
  "storage": {
    "mysql_volume": "/srv/cluster/mysql",
    "valkey_volume": "/srv/cluster/valkey",
    "artifacts_volume": "/srv/cluster/artifacts"
  },
  "backup": {
    "endpoint": "https://backup.example.invalid",
    "probe_path": "/api/read-only/target-identity",
    "identity_json_pointer": "/id",
    "target_id": "replace-with-backup-target-id",
    "restore_endpoint": "https://restore.example.invalid",
    "restore_probe_path": "/api/read-only/target-identity",
    "restore_identity_json_pointer": "/id",
    "restore_target_id": "replace-with-restore-target-id"
  },
  "network": {
    "public_ports": [443],
    "state_ports": [3306, 6379]
  }
}
