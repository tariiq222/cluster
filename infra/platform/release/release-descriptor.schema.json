{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://third-health-cluster.invalid/schemas/release-descriptor-2.json",
  "title": "Third Health Cluster independently verifiable release descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["descriptor_version", "release_id", "git_revision", "images", "compose", "migration_plan", "rollback_plan", "manifest", "signature", "bundle"],
  "properties": {
    "descriptor_version": {"const": "2"},
    "release_id": {"type": "string", "minLength": 1},
    "git_revision": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "images": {"$ref": "#/$defs/images"},
    "compose": {"$ref": "#/$defs/file"},
    "migration_plan": {"$ref": "#/$defs/file"},
    "rollback_plan": {"$ref": "#/$defs/file"},
    "manifest": {"$ref": "#/$defs/manifest"},
    "signature": {"$ref": "#/$defs/signedArtifact"},
    "bundle": {"$ref": "#/$defs/signedArtifact"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "safePath": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?:[^/]+/)*[^/]+$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/safePath"}, "sha256": {"$ref": "#/$defs/digest"}}
    },
    "sbom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "format", "image_reference", "image_digest"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/digest"},
        "format": {"enum": ["cyclonedx", "spdx"]},
        "image_reference": {"type": "string", "pattern": "^(?!.*(?:[?#]|://|@[^/]*:)).+@sha256:[0-9a-f]{64}$"},
        "image_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "image_digest"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/digest"},
        "image_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "digest", "sbom", "provenance"],
      "properties": {
        "reference": {"type": "string", "pattern": "^(?!.*(?:[?#]|://|@[^/]*:)).+@sha256:[0-9a-f]{64}$"},
        "digest": {"$ref": "#/$defs/digest"},
        "sbom": {"$ref": "#/$defs/sbom"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "web"],
      "properties": {"api": {"$ref": "#/$defs/image"}, "web": {"$ref": "#/$defs/image"}}
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "format"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/digest"},
        "format": {"const": "release-manifest-v1"}
      }
    },
    "signedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "format", "subject_sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/digest"},
        "format": {"enum": ["cosign-blob-signature", "cosign-bundle"]},
        "subject_sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
