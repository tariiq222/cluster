{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://third-health-cluster.invalid/schemas/release-license-policy-1.json",
  "title": "Third Health Cluster deny-by-default SBOM license policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_version", "default_action", "allowed_license_ids", "denied_license_ids"],
  "properties": {
    "policy_version": {"const": "1"},
    "default_action": {"const": "deny"},
    "allowed_license_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "denied_license_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
