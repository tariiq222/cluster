# Copy to .env.production on the VPS and replace every placeholder.
APP_DOMAIN=app.example.com
APP_KEY=base64:replace-with-php-artisan-key-generate-show

# Existing MySQL service. host.docker.internal works only when MySQL listens on
# a Docker-reachable private/bridge address, not only on 127.0.0.1.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=cluster
DB_USERNAME=cluster
DB_PASSWORD=replace-me

# Existing Redis service with the same Docker-reachable binding rule.
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=replace-me
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=cluster_

# Audit ledger integrity. Rotate by adding a new version:key entry, switching
# the active version, then retaining every historical key needed for verification.
AUDIT_INTEGRITY_KEYS=v1:replace-with-at-least-32-random-bytes
AUDIT_INTEGRITY_KEY_VERSION=v1
AUDIT_INTEGRITY_BATCH_SIZE=500
AUDIT_RETENTION_DAYS=2555
AUDIT_EXPORT_MAX_WINDOW_DAYS=90
AUDIT_EXPORT_EXPIRES_DAYS=7

LOG_LEVEL=info
