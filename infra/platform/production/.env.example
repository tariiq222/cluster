# Copy to .env.production on the VPS and replace every placeholder.
APP_DOMAIN=app.example.com
APP_KEY=base64:replace-with-php-artisan-key-generate-show

# Existing MySQL service. host.docker.internal works only when MySQL listens on
# a Docker-reachable private/bridge address, not only on 127.0.0.1.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=cluster
DB_USERNAME=cluster
DB_PASSWORD=replace-me

# Existing Redis service with the same Docker-reachable binding rule.
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=replace-me
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=cluster_

# Audit ledger integrity. Rotate by adding a new version:key entry, switching
# the active version, then retaining every historical key needed for verification.
AUDIT_INTEGRITY_KEYS=v1:replace-with-at-least-32-random-bytes
AUDIT_INTEGRITY_KEY_VERSION=v1
AUDIT_INTEGRITY_BATCH_SIZE=500
AUDIT_RETENTION_DAYS=2555
AUDIT_EXPORT_MAX_WINDOW_DAYS=90
AUDIT_EXPORT_EXPIRES_DAYS=7
# Required only while the irreversible W27 retirement is pending. Use IDs from
# the backup system and a completed restore-validation run, never free text.
DESTRUCTIVE_MIGRATION_BACKUP_ID=<backup-system-id>
DESTRUCTIVE_MIGRATION_RESTORE_VALIDATION_ID=<restore-validation-id>

# Documents runtime. Quarantine and available disks intentionally use separate
# credentials, buckets, and KMS keys.
DOCUMENTS_PRODUCTION_RUNTIME_ENABLED=true
DOCUMENTS_UPLOAD_ENDPOINT_ALLOWLIST=s3.example.internal
DOCUMENTS_WORKER_TOKEN=replace-with-at-least-32-random-bytes
DOCUMENTS_WORKER_USER_ID=replace-with-worker-user-uuid
DOCUMENTS_WORKER_ORGANIZATION_UNIT_ID=replace-with-worker-unit-uuid
DOCUMENTS_S3_REGION=me-central-1
DOCUMENTS_S3_ENDPOINT=https://s3.example.internal
DOCUMENTS_S3_USE_PATH_STYLE=false
DOCUMENTS_S3_QUARANTINE_BUCKET=cluster-documents-quarantine
DOCUMENTS_S3_AVAILABLE_BUCKET=cluster-documents-available
DOCUMENTS_S3_ACCESS_KEY_ID=replace-with-service-access-key
DOCUMENTS_S3_SECRET_ACCESS_KEY=replace-with-service-secret-key
DOCUMENTS_UPLOAD_INTENT_TTL_SECONDS=300
DOCUMENTS_CLAMAV_TRANSPORT=tcp
DOCUMENTS_CLAMAV_HOST=host.docker.internal
DOCUMENTS_CLAMAV_PORT=3310
DOCUMENTS_CLAMAV_ENGINE_NAME=clamav
DOCUMENTS_CLAMAV_SIGNATURE_VERSION=replace-with-deployed-signature-version
DOCUMENTS_QUARANTINE_AWS_ACCESS_KEY_ID=replace-with-quarantine-access-key
DOCUMENTS_QUARANTINE_AWS_SECRET_ACCESS_KEY=replace-with-quarantine-secret-key
DOCUMENTS_QUARANTINE_AWS_DEFAULT_REGION=me-central-1
DOCUMENTS_QUARANTINE_AWS_BUCKET=cluster-documents-quarantine
DOCUMENTS_QUARANTINE_AWS_ENDPOINT=https://s3.example.internal
DOCUMENTS_QUARANTINE_AWS_USE_PATH_STYLE_ENDPOINT=false
DOCUMENTS_QUARANTINE_KMS_KEY_ID=replace-with-quarantine-kms-key
DOCUMENTS_AVAILABLE_AWS_ACCESS_KEY_ID=replace-with-available-access-key
DOCUMENTS_AVAILABLE_AWS_SECRET_ACCESS_KEY=replace-with-available-secret-key
DOCUMENTS_AVAILABLE_AWS_DEFAULT_REGION=me-central-1
DOCUMENTS_AVAILABLE_AWS_BUCKET=cluster-documents-available
DOCUMENTS_AVAILABLE_AWS_ENDPOINT=https://s3.example.internal
DOCUMENTS_AVAILABLE_AWS_USE_PATH_STYLE_ENDPOINT=false
DOCUMENTS_AVAILABLE_KMS_KEY_ID=replace-with-available-kms-key

LOG_LEVEL=info
