{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cluster.internal/contracts/net04-network-policy.schema.json",
  "title": "W11-NET-04 network exposure policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "compose", "firewall", "forbidden_public", "endpoints"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "compose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "frontend_network",
        "state_network",
        "runtime_frontend_network",
        "runtime_state_network",
        "proxy_service",
        "proxy_loopback_tcp_ports",
        "service_networks",
        "required_running_services"
      ],
      "properties": {
        "project": {"$ref": "#/$defs/identifier"},
        "frontend_network": {"$ref": "#/$defs/identifier"},
        "state_network": {"$ref": "#/$defs/identifier"},
        "runtime_frontend_network": {"$ref": "#/$defs/identifier"},
        "runtime_state_network": {"$ref": "#/$defs/identifier"},
        "proxy_service": {"$ref": "#/$defs/identifier"},
        "proxy_loopback_tcp_ports": {"const": [8080]},
        "service_networks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["web", "api", "worker", "scheduler", "migrate", "mysql", "valkey"],
          "properties": {
            "web": {"const": ["frontend"]},
            "api": {"const": ["frontend", "state"]},
            "worker": {"const": ["state"]},
            "scheduler": {"const": ["state"]},
            "migrate": {"const": ["state"]},
            "mysql": {"const": ["state"]},
            "valkey": {"const": ["state"]}
          }
        },
        "required_running_services": {"const": ["web", "api", "worker", "scheduler", "mysql", "valkey"]}
      }
    },
    "firewall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "table", "input_chain", "public_https_ports", "management_tcp_ports", "management_allowed_cidrs"],
      "properties": {
        "family": {"enum": ["inet", "ip", "ip6"]},
        "table": {"$ref": "#/$defs/identifier"},
        "input_chain": {"$ref": "#/$defs/identifier"},
        "public_https_ports": {"const": [443]},
        "management_tcp_ports": {"$ref": "#/$defs/ports"},
        "management_allowed_cidrs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "anyOf": [
                {"pattern": "^(?:10\\.(?:[0-9]{1,3}\\.){2}[0-9]{1,3}|172\\.(?:1[6-9]|2[0-9]|3[0-1])\\.(?:[0-9]{1,3}\\.)[0-9]{1,3}|192\\.168\\.(?:[0-9]{1,3}\\.)[0-9]{1,3})/(?:2[4-9]|3[0-2])$"},
                {"pattern": "^f[cd][0-9a-fA-F:]+/(?:6[4-9]|[78][0-9]|9[0-9]|1[01][0-9]|12[0-8])$"}
              ]
            }
          }
        }
      },
    "forbidden_public": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tcp_ports", "mount_sources"],
      "properties": {
        "tcp_ports": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mysql", "valkey", "docker", "dokploy"],
          "properties": {
        "mysql": {"const": [3306]},
            "valkey": {"const": [6379]},
            "docker": {"const": [2375, 2376]},
            "dokploy": {"const": [3000, 3001]}
          }
        },
        "mount_sources": {"const": ["/var/run/docker.sock"]}
      }
    },
    "endpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_https_origin", "management_https_origin", "management_health_path", "user_denied_management_statuses", "management_success_status"],
      "properties": {
        "public_https_origin": {"$ref": "#/$defs/httpsOrigin"},
        "management_https_origin": {"$ref": "#/$defs/httpsOrigin"},
        "management_health_path": {"$ref": "#/$defs/path"},
        "user_denied_management_statuses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 400, "maximum": 499}},
        "management_success_status": {"type": "integer", "minimum": 200, "maximum": 299}
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
    "ports": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 65535}},
    "httpsOrigin": {"type": "string", "pattern": "^https://(?:[^/?#@:\\[\\]]+|\\[[0-9A-Fa-f:]+\\])(?::443)?/?$"},
    "path": {"type": "string", "pattern": "^/(?!.*(?:\\.\\.|[?#])).+$"}
  },
  "x-security-rules": [
    "The Compose proxy may publish HTTP only to a literal loopback address; a variable or wildcard bind is rejected.",
    "Only the state network may contain MySQL and Valkey, and it must be internal at both Compose and Docker runtime layers.",
    "The host firewall must have an input default-deny policy, a source-unrestricted HTTPS accept rule, and management TCP accepts restricted exactly to approved CIDRs.",
    "No raw command output, endpoint address, source address, credential, or secret value may enter an exposure receipt."
  ]
}
