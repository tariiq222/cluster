{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cluster.internal/contracts/restore-receipt-1.0.0.json",
  "title": "W11 DR-06 separate-target restore receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_version", "contract", "status", "acceptance", "environment", "backup_id", "backup_manifest_sha256", "restore_id", "source_host_id", "source_storage_id", "source_identity", "backup_target_id", "backup_target_host_id", "backup_target_storage_id", "backup_target_identity", "restore_target_id", "restore_target_host_id", "restore_target_storage_id", "restore_target_identity", "checks", "data_proof", "backup_encryption", "checksum_algorithm", "signature_verification", "raw_timing", "timing", "critical_journeys", "observed_at", "receipt_sha256"],
  "properties": {
    "receipt_version": {"const": "1.0.0"},
    "contract": {"const": "W11-DR-06"},
    "status": {"const": "passed"},
    "acceptance": {"type": "object", "additionalProperties": false, "required": ["status", "acceptable"], "properties": {"status": {"const": "unsigned"}, "acceptable": {"const": false}}},
    "environment": {"enum": ["staging", "production"]},
    "backup_id": {"type": "string", "minLength": 1},
    "backup_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "restore_id": {"type": "string", "minLength": 1},
    "source_host_id": {"type": "string", "minLength": 1},
    "source_storage_id": {"type": "string", "minLength": 1},
    "source_identity": {"$ref": "#/$defs/identity"},
    "backup_target_id": {"type": "string", "minLength": 1},
    "backup_target_host_id": {"type": "string", "minLength": 1},
    "backup_target_storage_id": {"type": "string", "minLength": 1},
    "backup_target_identity": {"$ref": "#/$defs/identity"},
    "restore_target_id": {"type": "string", "minLength": 1},
    "restore_target_host_id": {"type": "string", "minLength": 1},
    "restore_target_storage_id": {"type": "string", "minLength": 1},
    "restore_target_identity": {"$ref": "#/$defs/identity"},
    "checks": {"type": "object", "additionalProperties": false, "required": ["checksum", "signature", "database", "files", "schema", "health"], "properties": {"checksum": {"const": "passed"}, "signature": {"const": "passed"}, "database": {"const": "passed"}, "files": {"const": "passed"}, "schema": {"const": "passed"}, "health": {"const": "passed"}}},
    "data_proof": {"$ref": "#/$defs/dataProof"},
    "backup_encryption": {"type": "object", "additionalProperties": false, "required": ["algorithm", "key_id"], "properties": {"algorithm": {"enum": ["AES-256-GCM", "age", "SSE-KMS"]}, "key_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"}}},
    "checksum_algorithm": {"enum": ["sha256", "sha512"]},
    "signature_verification": {"type": "object", "additionalProperties": false, "required": ["returncode", "verified", "command_sha256", "stdout_sha256", "stderr_sha256", "artifact_sha256", "signature_sha256", "bundle_sha256", "public_key_sha256", "cosign_sha256", "cosign_version"], "properties": {"returncode": {"const": 0}, "verified": {"const": true}, "command_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "signature_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "public_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "cosign_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "cosign_version": {"type": "string", "minLength": 1}}},
    "raw_timing": {"$ref": "#/$defs/rawTiming"},
    "timing": {"type": "object", "additionalProperties": false, "required": ["rpo_seconds", "rto_seconds", "rpo_limit_seconds", "rto_limit_seconds", "rpo_within_limit", "rto_within_limit"], "properties": {"rpo_seconds": {"type": "integer", "minimum": 0}, "rto_seconds": {"type": "integer", "minimum": 0}, "rpo_limit_seconds": {"const": 900}, "rto_limit_seconds": {"const": 7200}, "rpo_within_limit": {"const": true}, "rto_within_limit": {"const": true}}},
    "critical_journeys": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/journey"}},
    "observed_at": {"type": "string", "format": "date-time"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "safePath": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\s\\x00\\r\\n]).+$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "rawTiming": {"type": "object", "additionalProperties": false, "required": ["last_write_at", "backup_completed_at", "restore_started_at", "restore_completed_at"], "properties": {"last_write_at": {"$ref": "#/$defs/timestamp"}, "backup_completed_at": {"$ref": "#/$defs/timestamp"}, "restore_started_at": {"$ref": "#/$defs/timestamp"}, "restore_completed_at": {"$ref": "#/$defs/timestamp"}}},
    "identity": {"type": "object", "additionalProperties": false, "required": ["host_id", "storage_id", "evidence_ref", "evidence_sha256"], "properties": {"host_id": {"type": "string", "minLength": 1}, "storage_id": {"type": "string", "minLength": 1}, "evidence_ref": {"$ref": "#/$defs/safePath"}, "evidence_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}}},
    "dataProof": {"type": "object", "additionalProperties": false, "required": ["evidence_ref", "evidence_sha256", "sample_hash"], "properties": {"evidence_ref": {"$ref": "#/$defs/safePath"}, "evidence_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}, "sample_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64,128}$"}}},
    "journey": {"type": "object", "additionalProperties": false, "required": ["id", "locale", "status", "duration_ms", "evidence_ref", "evidence_sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "locale": {"enum": ["ar", "en"]}, "status": {"const": "passed"}, "duration_ms": {"type": "integer", "minimum": 0, "exclusiveMaximum": 5000}, "evidence_ref": {"$ref": "#/$defs/safePath"}, "evidence_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}}}
  }
}
