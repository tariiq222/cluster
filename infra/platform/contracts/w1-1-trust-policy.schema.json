{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cluster.internal/contracts/w1-1-trust-policy-1.0.0.json",
  "title": "W1.1 signed evidence trust policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "keys"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "keys": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/key"}}
  },
  "$defs": {
    "key": {
      "type": "object", "additionalProperties": false,
      "required": ["public_key_path", "public_key_fingerprint", "allowed_roles", "allowed_artifact_types"],
      "properties": {
        "public_key_path": {"type": "string", "pattern": "^/[^\\x00\\r\\n]+$"},
        "public_key_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "allowed_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "allowed_artifact_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["release-descriptor", "host", "net-host", "net-user", "net-management", "deployment", "restore", "ci", "test-result", "approval"]}}
      }
    }
  }
}
