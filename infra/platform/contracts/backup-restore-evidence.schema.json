{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cluster.internal/contracts/backup-restore-evidence-1.0.0.json",
  "title": "W11 DR-06 encrypted backup and separate restore evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "backup_id", "environment", "source_host_id", "source_storage_id", "source_identity", "target_id", "target_host_id", "target_storage_id", "target_identity", "created_at", "completed_at", "last_write_at", "encryption", "checksum", "signature", "immutable_retention_until", "artifacts"],
  "properties": {
    "contract_version": {"const": "1.0.0"}, "backup_id": {"type": "string", "minLength": 1},
    "environment": {"enum": ["staging", "production"]}, "source_host_id": {"type": "string", "minLength": 1}, "source_storage_id": {"type": "string", "minLength": 1}, "source_identity": {"$ref": "#/$defs/identity"}, "target_id": {"type": "string", "minLength": 1}, "target_host_id": {"type": "string", "minLength": 1}, "target_storage_id": {"type": "string", "minLength": 1}, "target_identity": {"$ref": "#/$defs/identity"},
    "created_at": {"$ref": "#/$defs/timestamp"}, "completed_at": {"$ref": "#/$defs/timestamp"}, "last_write_at": {"$ref": "#/$defs/timestamp"}, "immutable_retention_until": {"$ref": "#/$defs/timestamp"},
    "encryption": {"type": "object", "additionalProperties": false, "required": ["algorithm", "key_id", "encrypted_at_rest"], "properties": {"algorithm": {"enum": ["AES-256-GCM", "age", "SSE-KMS"]}, "key_id": {"type": "string", "minLength": 1}, "encrypted_at_rest": {"const": true}}},
    "checksum": {"type": "object", "additionalProperties": false, "required": ["algorithm", "value", "artifact_path"], "properties": {"algorithm": {"enum": ["sha256", "sha512"]}, "value": {"type": "string", "pattern": "^[0-9a-fA-F]{64,128}$"}, "artifact_path": {"$ref": "#/$defs/safePath"}}},
    "signature": {"type": "object", "additionalProperties": false, "required": ["algorithm", "key_id", "signature_path", "bundle_path", "public_key_path", "verification_status"], "properties": {"algorithm": {"const": "cosign"}, "key_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"}, "signature_path": {"$ref": "#/$defs/safePath"}, "bundle_path": {"$ref": "#/$defs/safePath"}, "public_key_path": {"$ref": "#/$defs/safePath"}, "verification_status": {"const": "verified"}}},
    "artifacts": {"type": "object", "additionalProperties": false, "required": ["database", "files", "binlog_position"], "properties": {"database": {"$ref": "#/$defs/artifact"}, "files": {"$ref": "#/$defs/artifact"}, "binlog_position": {"type": "string", "minLength": 1}}}
  },
  "$defs": {
    "timestamp": {"type": "string", "format": "date-time"},
    "safePath": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\s\\x00\\r\\n]).+$"},
    "proof": {"type": "object", "additionalProperties": false, "required": ["evidence_ref", "evidence_sha256"], "properties": {"evidence_ref": {"$ref": "#/$defs/safePath"}, "evidence_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}}},
    "identity": {"type": "object", "additionalProperties": false, "required": ["host_id", "storage_id", "evidence_ref", "evidence_sha256"], "properties": {"host_id": {"type": "string", "minLength": 1}, "storage_id": {"type": "string", "minLength": 1}, "evidence_ref": {"$ref": "#/$defs/safePath"}, "evidence_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["included", "object_id", "evidence_ref", "evidence_sha256"], "properties": {"included": {"const": true}, "object_id": {"type": "string", "minLength": 1}, "evidence_ref": {"$ref": "#/$defs/safePath"}, "evidence_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}}}
  }
}
