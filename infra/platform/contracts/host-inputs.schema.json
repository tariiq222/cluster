{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cluster.internal/contracts/host-inputs.schema.json",
  "title": "W1.1 non-secret host inputs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "environment",
    "host",
    "public_endpoint",
    "management",
    "registry",
    "dokploy",
    "storage",
    "backup",
    "network"
  ],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "environment": {"enum": ["staging", "production"]},
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "data_root", "minimum_free_gib", "timezone"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "owner": {"$ref": "#/$defs/identifier"},
        "data_root": {"$ref": "#/$defs/absolutePath"},
        "minimum_free_gib": {"type": "integer", "minimum": 1},
        "timezone": {"type": "string", "minLength": 1}
      }
    },
    "public_endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "ports"],
      "properties": {
        "origin": {"$ref": "#/$defs/httpsOrigin"},
        "ports": {"type": "array", "const": [443]}
      }
    },
    "management": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "health_path", "allowed_cidrs", "ports"],
      "properties": {
        "origin": {"$ref": "#/$defs/httpsOrigin"},
        "health_path": {"type": "string", "pattern": "^/(?!.*\\.\\.)(?!.*\\?).+$"},
        "allowed_cidrs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:10\\.|172\\.(?:1[6-9]|2[0-9]|3[01])\\.|192\\.168\\.|f[c-d][0-9A-Fa-f:]*)"
          }
        },
        "ports": {"$ref": "#/$defs/ports"}
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname", "port", "repository"],
      "properties": {
        "hostname": {"type": "string", "pattern": "^[A-Za-z0-9.-]+\\.[A-Za-z0-9.-]+$"},
        "port": {"const": 443},
        "repository": {"type": "string", "pattern": "^[a-z0-9]+(?:[._/-][a-z0-9]+)*$"}
      }
    },
    "dokploy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "compose_name", "probe_path", "project_json_pointer", "compose_json_pointer"],
      "properties": {
        "project": {"$ref": "#/$defs/identifier"},
        "compose_name": {"$ref": "#/$defs/identifier"},
        "probe_path": {"$ref": "#/$defs/probePath"},
        "project_json_pointer": {"$ref": "#/$defs/jsonPointer"},
        "compose_json_pointer": {"$ref": "#/$defs/jsonPointer"}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mysql_volume", "valkey_volume", "artifacts_volume"],
      "properties": {
        "mysql_volume": {"$ref": "#/$defs/absolutePath"},
        "valkey_volume": {"$ref": "#/$defs/absolutePath"},
        "artifacts_volume": {"$ref": "#/$defs/absolutePath"}
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "probe_path",
        "identity_json_pointer",
        "target_id",
        "restore_endpoint",
        "restore_probe_path",
        "restore_identity_json_pointer",
        "restore_target_id"
      ],
      "properties": {
        "endpoint": {"type": "string", "pattern": "^https://[^/?#@]+(?:/[^?#]*)?$"},
        "probe_path": {"$ref": "#/$defs/probePath"},
        "identity_json_pointer": {"$ref": "#/$defs/jsonPointer"},
        "target_id": {"$ref": "#/$defs/identifier"},
        "restore_endpoint": {"type": "string", "pattern": "^https://[^/?#@]+(?:/[^?#]*)?$"},
        "restore_probe_path": {"$ref": "#/$defs/probePath"},
        "restore_identity_json_pointer": {"$ref": "#/$defs/jsonPointer"},
        "restore_target_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_ports", "state_ports"],
      "properties": {
        "public_ports": {"type": "array", "const": [443]},
        "state_ports": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": [3306, 6379]}
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "httpsOrigin": {
      "type": "string",
      "pattern": "^https://[^/?#@]+/?$"
    },
    "probePath": {
      "type": "string",
      "pattern": "^/(?!.*(?:\\.\\.|[?#])).+$"
    },
    "jsonPointer": {
      "type": "string",
      "pattern": "^/.+$"
    },
    "ports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1, "maximum": 65535}
    }
  },
  "x-security-rules": [
    "Management CIDRs must be canonical subnets of RFC1918 or IPv6 ULA networks; scripts/host_preflight.py is authoritative for this semantic rule.",
    "Public and management ports must not include state-service ports.",
    "Backup and restore endpoints and identities must be separate from production and from each other.",
    "Live probes must authenticate with runtime-only credentials, reject redirects, and match configured identities without recording bodies or headers.",
    "Secret values are forbidden; only the separate required-secret name manifest is allowed."
  ]
}
