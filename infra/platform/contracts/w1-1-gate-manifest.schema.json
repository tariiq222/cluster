{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cluster.internal/contracts/w1-1-gate-manifest-1.0.0.json",
  "title": "W1.1 Gate-07 path-oriented evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "git_revision", "as_of", "max_age_seconds", "release_descriptor", "evidence"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "git_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "as_of": {"type": "string", "format": "date-time"},
    "max_age_seconds": {"type": "integer", "minimum": 1, "maximum": 604800},
    "release_descriptor": {"$ref": "#/$defs/releaseProof"},
    "evidence": {"$ref": "#/$defs/evidence"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safePath": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://)(?!.*\\\\)(?!.*[\\s\\x00\\r\\n]).+$"},
    "proof": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/safePath"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "releaseProof": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "key_id"],
      "properties": {"path": {"$ref": "#/$defs/safePath"}, "sha256": {"$ref": "#/$defs/sha256"}, "key_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"}}
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["host", "net-host", "net-user", "net-management", "deployment", "restore", "ci", "tests", "approvals"],
      "properties": {
        "host": {"$ref": "#/$defs/proof"}, "net-host": {"$ref": "#/$defs/proof"}, "net-user": {"$ref": "#/$defs/proof"}, "net-management": {"$ref": "#/$defs/proof"}, "deployment": {"$ref": "#/$defs/proof"}, "restore": {"$ref": "#/$defs/proof"}, "ci": {"$ref": "#/$defs/proof"},
        "tests": {"type": "object", "additionalProperties": false, "required": ["TEST-R1-W1.1-01", "TEST-R1-W1.1-02", "TEST-R1-W1.1-03", "TEST-R1-W1.1-04", "TEST-R1-W1.1-05", "TEST-R1-W1.1-06", "TEST-R1-W1.1-07", "TEST-R1-W1.1-08"], "properties": {
          "TEST-R1-W1.1-01": {"$ref": "#/$defs/proof"}, "TEST-R1-W1.1-02": {"$ref": "#/$defs/proof"}, "TEST-R1-W1.1-03": {"$ref": "#/$defs/proof"}, "TEST-R1-W1.1-04": {"$ref": "#/$defs/proof"}, "TEST-R1-W1.1-05": {"$ref": "#/$defs/proof"}, "TEST-R1-W1.1-06": {"$ref": "#/$defs/proof"}, "TEST-R1-W1.1-07": {"$ref": "#/$defs/proof"}, "TEST-R1-W1.1-08": {"$ref": "#/$defs/proof"}
        }},
        "approvals": {"type": "object", "additionalProperties": false, "required": ["technology_lead", "sre_lead", "security_lead"], "properties": {
          "technology_lead": {"$ref": "#/$defs/proof"}, "sre_lead": {"$ref": "#/$defs/proof"}, "security_lead": {"$ref": "#/$defs/proof"}
        }}
      }
    }
  }
}
