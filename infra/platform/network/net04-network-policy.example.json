{
  "contract_version": "1.0.0",
  "compose": {
    "project": "cluster",
    "frontend_network": "frontend",
    "state_network": "state",
    "runtime_frontend_network": "cluster_frontend",
    "runtime_state_network": "cluster_state",
    "proxy_service": "web",
    "proxy_loopback_tcp_ports": [8080],
    "service_networks": {
      "web": ["frontend"],
      "api": ["frontend", "state"],
      "worker": ["state"],
      "scheduler": ["state"],
      "migrate": ["state"],
      "mysql": ["state"],
      "valkey": ["state"]
    },
    "required_running_services": ["web", "api", "worker", "scheduler", "mysql", "valkey"]
  },
  "firewall": {
    "family": "inet",
    "table": "filter",
    "input_chain": "input",
    "public_https_ports": [443],
    "management_tcp_ports": [22],
    "management_allowed_cidrs": ["10.0.0.0/24"]
  },
  "forbidden_public": {
    "tcp_ports": {
      "mysql": [3306],
      "valkey": [6379],
      "docker": [2375, 2376],
      "dokploy": [3000, 3001]
    },
    "mount_sources": ["/var/run/docker.sock"]
  },
  "endpoints": {
    "public_https_origin": "https://cluster.example.invalid",
    "management_https_origin": "https://dokploy.example.invalid",
    "management_health_path": "/api/health",
    "user_denied_management_statuses": [401, 403, 404],
    "management_success_status": 200
  }
}
