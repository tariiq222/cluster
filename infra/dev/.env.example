# Development-only defaults. Never use this file for production credentials.
W1_1_COMPOSE_PROJECT=cluster-w1-1
W1_1_MYSQL_PORT=33060
W1_1_REDIS_PORT=6380
W1_1_API_PORT=8000
W1_1_WEB_PORT=4173
W1_1_MYSQL_DATABASE=cluster
W1_1_MYSQL_USER=cluster
W1_1_MYSQL_PASSWORD=local-dev-password
W1_1_MYSQL_ROOT_PASSWORD=local-dev-root
W1_1_HEALTH_TIMEOUT_SECONDS=90

# Required for the local MinIO instance. Copy this file to infra/dev/.env and
# set unique local-only values; these are intentionally not committed.
W1_2_MINIO_ROOT_USER=
W1_2_MINIO_ROOT_PASSWORD=
W1_2_MINIO_API_PORT=9000
W1_2_MINIO_CONSOLE_PORT=9001
W1_2_CLAMAV_PORT=3310
