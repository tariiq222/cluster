\n                                        <td class=\"p-5 font-mono text-navy font-bold\" data-kid=\"2-2-2-2-3-1-2-1-2-2-1\" data-name=\"req id cell\">\n                                            REQ-1088\n                                        </td>\n                                        <td class=\"p-5 font-bold text-gray-800\" data-kid=\"2-2-2-2-3-1-2-1-2-2-2\" data-name=\"description cell\">\n                                            نقل المريض (ICU -> SURG)\n                                        </td>\n                                        <td class=\"p-5 font-mono text-gray-500 font-bold\" data-kid=\"2-2-2-2-3-1-2-1-2-2-3\" data-name=\"date cell\" dir=\"ltr\">\n                                            22-05-24\n                                        </td>\n                                        <td class=\"p-4\" data-kid=\"2-2-2-2-3-1-2-1-2-2-4\" data-name=\"status cell\">\n                                            <div class=\"status-marker border-green-600 text-green-600\" data-kid=\"2-2-2-2-3-1-2-1-2-2-4-1\" data-name=\"status marker\">\n                                                EXECUTED\n                                            </div>\n                                        </td>\n                                    </tr>\n                                    <tr class=\"hover:bg-gray-50 transition-colors cursor-default\" data-kid=\"2-2-2-2-3-1-2-1-2-3\" data-name=\"row 3\">\n                                        <td class=\"p-5 font-mono text-navy font-bold\" data-kid=\"2-2-2-2-3-1-2-1-2-3-1\" data-name=\"req id cell\">\n                                            REQ-1074\n                                        </td>\n                                        <td class=\"p-5 font-bold text-gray-800\" data-kid=\"2-2-2-2-3-1-2-1-2-3-2\" data-name=\"description cell\">\n                                            معايرة أجهزة التنفس الاصطناعي\n                                        </td>\n                                        <td class=\"p-5 font-mono text-gray-500 font-bold\" data-kid=\"2-2-2-2-3-1-2-1-2-3-3\" data-name=\"date cell\" dir=\"ltr\">\n                                            21-05-24\n                                        </td>\n                                        <td class=\"p-4\" data-kid=\"2-2-2-2-3-1-2-1-2-3-4\" data-name=\"status cell\">\n                                            <div class=\"status-marker border-navy text-navy\" data-kid=\"2-2-2-2-3-1-2-1-2-3-4-1\" data-name=\"status marker\">\n                                                SCHEDULED\n                                            </div>\n                                        </td>\n                                    </tr>\n                                </tbody>\n                            </table>\n                        </div>\n                    </section>\n                    <!-- Notifications -->\n                    <section class=\"bg-white border border-navy shadow-xs notifications-card\" data-kid=\"2-2-2-2-3-2\" data-name=\"central notifications card\">\n                        <div class=\"p-4 border-b border-navy flex items-center justify-between bg-gray-50/50\" data-kid=\"2-2-2-2-3-2-1\" data-name=\"notifications header\">\n                            <h2 class=\"text-xs font-black uppercase tracking-widest\" data-kid=\"2-2-2-2-3-2-1-1\" data-name=\"notifications title\">\n                                سجل التنبيهات المركزية\n                            </h2>\n                            <span class=\"text-[9px] font-mono bg-navy text-white px-2 py-0.5 font-bold\" data-kid=\"2-2-2-2-3-2-1-2\" data-name=\"log count badge\">\n                                LOG: 142\n                            </span>\n                        </div>\n                        <div class=\"divide-y divide-gray-100\" data-kid=\"2-2-2-2-3-2-2\" data-name=\"notifications list\">\n                            <div class=\"p-4 flex gap-4 group hover:bg-gray-50 transition-colors\" data-kid=\"2-2-2-2-3-2-2-1\" data-name=\"notification item 1\">\n                                <div class=\"w-1 bg-red-600 shrink-0\" data-kid=\"2-2-2-2-3-2-2-1-1\" data-name=\"severity stripe\">\n                                </div>\n                                <div class=\"flex-1\" data-kid=\"2-2-2-2-3-2-2-1-2\" data-name=\"notification content\">\n                                    <div class=\"flex justify-between items-center mb-1\" data-kid=\"2-2-2-2-3-2-2-1-2-1\" data-name=\"notification metadata\">\n                                        <h3 class=\"font-black text-[10px] text-red-600 uppercase\" data-kid=\"2-2-2-2-3-2-2-1-2-1-1\" data-name=\"notification title\">\n                                            SYS_ERR: POWER_GRID_C\n                                        </h3>\n                                        <span class=\"font-mono text-[9px] text-gray-400\" data-kid=\"2-2-2-2-3-2-2-1-2-1-2\" data-name=\"notification timestamp\">\n                                            14:22\n                                        </span>\n                                    </div>\n                                    <p class=\"text-[11px] leading-relaxed text-gray-600 font-semibold italic\" data-kid=\"2-2-2-2-3-2-2-1-2-2\" data-name=\"notification message\">\n                                        تم رصد تذبذب في التيار الكهربائي بالمبنى (ج). النظام الاحتياطي في وضع الاستعداد الفوري.\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"p-4 flex gap-4 group hover:bg-gray-50 transition-colors\" data-kid=\"2-2-2-2-3-2-2-2\" data-name=\"notification item 2\">\n                                <div class=\"w-1 bg-navy shrink-0\" data-kid=\"2-2-2-2-3-2-2-2-1\" data-name=\"severity stripe\">\n                                </div>\n                                <div class=\"flex-1\" data-kid=\"2-2-2-2-3-2-2-2-2\" data-name=\"notification content\">\n                                    <div class=\"flex justify-between items-center mb-1\" data-kid=\"2-2-2-2-3-2-2-2-2-1\" data-name=\"notification metadata\">\n                                        <h3 class=\"font-black text-[10px] text-navy uppercase\" data-kid=\"2-2-2-2-3-2-2-2-2-1-1\" data-name=\"notification title\">\n                                            INFO: PROTOCOL_UPDATE\n                                        </h3>\n                                        <span class=\"font-mono text-[9px] text-gray-400\" data-kid=\"2-2-2-2-3-2-2-2-2-1-2\" data-name=\"notification timestamp\">\n                                            12:05\n                                        </span>\n                                    </div>\n                                    <p class=\"text-[11px] leading-relaxed text-gray-600 font-semibold italic\" data-kid=\"2-2-2-2-3-2-2-2-2-2\" data-name=\"notification message\">\n                                        تم تعديل معايير القبول في قسم الطوارئ للأمراض الموسمية. المرجو تحديث السجلات.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"p-4 border-t border-gray-100 bg-gray-50 text-center\" data-kid=\"2-2-2-2-3-2-3\" data-name=\"notifications footer\">\n                            <button class=\"text-[9px] font-black uppercase tracking-widest text-navy hover:underline\" data-kid=\"2-2-2-2-3-2-3-1\" data-name=\"view all notifications button\">\n                                عرض كافة السجلات (F12)\n                            </button>\n                        </div>\n                    </section>\n                </div>\n            </div>\n        </div>\n    </main>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script>\n    document.addEventListener('DOMContentLoaded', () => {\n        // Fast institutional entrance animations\n        const tl = gsap.timeline({ defaults: { ease: \"power3.out\", duration: 0.5 } });\n\n        // Set initial states to avoid FOUC (though guidelines say no opacity-0, gsap handles it)\n        tl.from(\"#sidebar\", { x: 80, opacity: 0 })\n          .from(\"#header\", { y: -60, opacity: 0 }, \"-=0.3\")\n          .from(\".nav-item\", { x: 20, opacity: 0, stagger: 0.05 }, \"-=0.3\")\n          .from(\".kpi-item\", { y: 20, opacity: 0, stagger: 0.08 }, \"-=0.2\")\n          .from(\".analytics-card\", { scale: 0.99, opacity: 0 }, \"-=0.2\")\n          .from(\".status-card\", { x: -20, opacity: 0 }, \"-=0.3\")\n          .from(\".requests-card, .notifications-card\", { y: 30, opacity: 0, stagger: 0.1 }, \"-=0.2\");\n\n        // Subtle bar animation\n        gsap.from(\".bar-fill\", {\n            width: 0,\n            duration: 1.5,\n            ease: \"expo.out\",\n            stagger: 0.1,\n            delay: 1.2\n        });\n    });\n</script>\n",
