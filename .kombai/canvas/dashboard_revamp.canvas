data-kid=\"2-2-2-3-2-1-2-2-3-1-1\" data-name=\"order type test pipe icon\">\n                                        </i>\n                                        فحص مخبري دم\n                                    </span>\n                                </td>\n                                <td class=\"py-6 px-8 font-numbers text-sm text-slate-500\" data-kid=\"2-2-2-3-2-1-2-2-4\" data-name=\"record timestamp\">\n                                    13:45 | 12.04.24\n                                </td>\n                                <td class=\"py-6 px-8\" data-kid=\"2-2-2-3-2-1-2-2-5\" data-name=\"status indicator container\">\n                                    <span class=\"inline-block min-w-20 text-center py-2 bg-[var(--accent-blue)] text-white text-[10px] font-bold uppercase tracking-wider\" data-kid=\"2-2-2-3-2-1-2-2-5-1\" data-name=\"status label\">\n                                        قيد التنفيذ\n                                    </span>\n                                </td>\n                            </tr>\n                            <tr class=\"zebra-row border-b border-black/5\" data-kid=\"2-2-2-3-2-1-2-3\" data-name=\"activity record three\">\n                                <td class=\"py-6 px-8 font-numbers font-bold text-slate-400\" data-kid=\"2-2-2-3-2-1-2-3-1\" data-name=\"record id\">\n                                    #ER-1122\n                                </td>\n                                <td class=\"py-6 px-8\" data-kid=\"2-2-2-3-2-1-2-3-2\" data-name=\"patient identity\">\n                                    <div class=\"font-bold\" data-kid=\"2-2-2-3-2-1-2-3-2-1\" data-name=\"patient name\">\n                                        خالد عبد الله العتيبي\n                                    </div>\n                                    <div class=\"text-xs text-slate-400\" data-kid=\"2-2-2-3-2-1-2-3-2-2\" data-name=\"patient file number\">\n                                        رقم الملف: 88231\n                                    </div>\n                                </td>\n                                <td class=\"py-6 px-8\" data-kid=\"2-2-2-3-2-1-2-3-3\" data-name=\"order type container\">\n                                    <span class=\"text-sm font-medium\" data-kid=\"2-2-2-3-2-1-2-3-3-1\" data-name=\"order type name\">\n                                        <i class=\"ti ti-ambulance mr-1\" data-kid=\"2-2-2-3-2-1-2-3-3-1-1\" data-name=\"order type ambulance icon\">\n                                        </i>\n                                        حالة طوارئ حرجة\n                                    </span>\n                                </td>\n                                <td class=\"py-6 px-8 font-numbers text-sm text-slate-500\" data-kid=\"2-2-2-3-2-1-2-3-4\" data-name=\"record timestamp\">\n                                    13:10 | 12.04.24\n                                </td>\n                                <td class=\"py-6 px-8\" data-kid=\"2-2-2-3-2-1-2-3-5\" data-name=\"status indicator container\">\n                                    <span class=\"inline-block min-w-20 text-center py-2 bg-red-600 text-white text-[10px] font-bold uppercase tracking-wider\" data-kid=\"2-2-2-3-2-1-2-3-5-1\" data-name=\"status label\">\n                                        عاجل جداً\n                                    </span>\n                                </td>\n                            </tr>\n                            <tr class=\"zebra-row\" data-kid=\"2-2-2-3-2-1-2-4\" data-name=\"activity record four\">\n                                <td class=\"py-6 px-8 font-numbers font-bold text-slate-400\" data-kid=\"2-2-2-3-2-1-2-4-1\" data-name=\"record id\">\n                                    #RX-7719\n                                </td>\n                                <td class=\"py-6 px-8\" data-kid=\"2-2-2-3-2-1-2-4-2\" data-name=\"patient identity\">\n                                    <div class=\"font-bold\" data-kid=\"2-2-2-3-2-1-2-4-2-1\" data-name=\"patient name\">\n                                        منى يوسف القحطاني\n                                    </div>\n                                    <div class=\"text-xs text-slate-400\" data-kid=\"2-2-2-3-2-1-2-4-2-2\" data-name=\"patient file number\">\n                                        رقم الملف: 55421\n                                    </div>\n                                </td>\n                                <td class=\"py-6 px-8\" data-kid=\"2-2-2-3-2-1-2-4-3\" data-name=\"order type container\">\n                                    <span class=\"text-sm font-medium\" data-kid=\"2-2-2-3-2-1-2-4-3-1\" data-name=\"order type name\">\n                                        <i class=\"ti ti-clock-check mr-1\" data-kid=\"2-2-2-3-2-1-2-4-3-1-1\" data-name=\"order type clock icon\">\n                                        </i>\n                                        متابعة دورية\n                                    </span>\n                                </td>\n                                <td class=\"py-6 px-8 font-numbers text-sm text-slate-500\" data-kid=\"2-2-2-3-2-1-2-4-4\" data-name=\"record timestamp\">\n                                    12:55 | 12.04.24\n                                </td>\n                                <td class=\"py-6 px-8\" data-kid=\"2-2-2-3-2-1-2-4-5\" data-name=\"status indicator container\">\n                                    <span class=\"inline-block min-w-20 text-center py-2 bg-slate-200 text-slate-500 text-[10px] font-bold uppercase tracking-wider\" data-kid=\"2-2-2-3-2-1-2-4-5-1\" data-name=\"status label\">\n                                        مجدول\n                                    </span>\n                                </td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n            </section>\n        </div>\n    </main>\n</div>\n<!-- JS Scripts -->\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script type=\"module\">\n    import Lenis from \"https://esm.sh/lenis@1\"\n    \n    // Smooth scroll\n    const lenis = new Lenis();\n    \n    // GSAP Animations\n    gsap.registerPlugin(ScrollTrigger);\n\n    // Synchronize Lenis with ScrollTrigger\n    lenis.on('scroll', ScrollTrigger.update);\n    gsap.ticker.add((time) => {\n        lenis.raf(time * 1000);\n    });\n    gsap.ticker.lagSmoothing(0);\n\n    // Purposeful Entrance for specific elements (Removed generic section fade)\n\n    // KPI Numbers count up\n    const kpis = document.querySelectorAll('.kpi-block');\n    kpis.forEach((kpi, i) => {\n        const num = kpi.querySelector('.font-numbers');\n        gsap.from(num, {\n            scrollTrigger: {\n                trigger: num,\n                start: \"top 90%\",\n            },\n            opacity: 0,\n            x: -20,\n            duration: 1.2,\n            ease: \"expo.out\",\n            delay: 0.5 + (i * 0.1)\n        });\n    });\n\n    // Chunky bar fills\n    const barRows = document.querySelectorAll('.bar-row');\n    barRows.forEach((row, i) => {\n        const fill = row.querySelector('.chunky-bar-fill');\n        const targetWidth = fill.style.width;\n        \n        gsap.set(fill, { width: '0%' });\n        \n        gsap.to(fill, {\n            scrollTrigger: {\n                trigger: row,\n                start: \"top 90%\",\n            },\n            width: targetWidth,\n            duration: 2,\n            ease: \"power4.inOut\",\n            delay: i * 0.15\n        });\n    });\n</script>\n",
      "comments": [],
      "created": "2026-07-18T14:22:21.774477+00:00",
      "modified": "2026-07-18T14:22:21.774477+00:00",
      "id": "var_8e789faa0ab2"
    },
    "var_69783374ffde": {
      "type": "variant",
      "label": "Institutional Clarity: Wireframe Precision",
      "parentId": "var_179ba27de628",
      "themeId": null,
      "rect": {
        "x": 4140,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<link data-kid=\"1\" data-name=\"google font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap');\n    \n    :root {\n        --navy-deep: #0A192F;\n        --navy-light: #172A45;\n        --cool-gray: #F4F5F7;\n        --text-main: #0A192F;\n        --divider: #D1D5DB;\n    }\n\n    .font-cairo { font-family: 'Cairo', sans-serif; }\n    .font-mono { font-family: 'IBM Plex Mono', monospace; }\n\n    .border-navy { border-color: var(--navy-deep); }\n    .bg-navy { background-color: var(--navy-deep); }\n    .text-navy { color: var(--navy-deep); }\n\n    /* Custom Scrollbar */\n    .custom-scroll::-webkit-scrollbar {\n        width: 4px;\n    }\n    .custom-scroll::-webkit-scrollbar-track {\n        background: var(--cool-gray);\n    }\n    .custom-scroll::-webkit-scrollbar-thumb {\n        background: #D1D5DB;\n    }\n    .custom-scroll::-webkit-scrollbar-thumb:hover {\n        background: var(--navy-deep);\n    }\n\n    /* Clinical Progress Bars */\n    .bar-container {\n        height: 4px;\n        background-color: #E2E8F0;\n        border-radius: 0;\n        overflow: hidden;\n    }\n    .bar-fill {\n        height: 100%;\n        border-radius: 0;\n    }\n\n    /* Status Indicators */\n    .status-marker {\n        border-right: 4px solid var(--navy-deep);\n        padding-right: 8px;\n        font-size: 10px;\n        font-weight: 700;\n    }\n\n    .grid-bg {\n        background-image: radial-gradient(var(--navy-deep) 0.5px, transparent 0.5px);\n        background-size: 10px 10px;\n        opacity: 0.05;\n    }\n</style>\n<div class=\"flex h-screen w-full overflow-hidden bg-[var(--cool-gray)] font-cairo text-[var(--text-main)]\" data-kid=\"2\" data-name=\"main layout container\" dir=\"rtl\">\n    <!-- Sidebar -->\n    <aside class=\"w-16 lg:w-20 bg-navy flex flex-col items-center py-8 shrink-0 z-50\" data-kid=\"2-1\" data-name=\"sidebar navigation\" id=\"sidebar\">\n        <div class=\"mb-12 text-white opacity-90\" data-kid=\"2-1-1\" data-name=\"sidebar logo wrapper\">\n            <i class=\"ti ti-shield text-3xl\" data-kid=\"2-1-1-1\" data-name=\"shield icon\">\n            </i>\n        </div>\n        <nav class=\"flex flex-col w-full\" data-kid=\"2-1-2\" data-name=\"navigation menu links\">\n            <a class=\"nav-item group relative py-5 flex justify-center text-white bg-white/5 border-r-4 border-white\" data-kid=\"2-1-2-1\" data-name=\"grid navigation link\" href=\"#\">\n                <i class=\"ti ti-layout-grid text-2xl\" data-kid=\"2-1-2-1-1\" data-name=\"grid icon\">\n                </i>\n            </a>\n            <a class=\"nav-item group relative py-5 flex justify-center text-gray-400 hover:text-white hover:bg-white/5\" data-kid=\"2-1-2-2\" data-name=\"users navigation link\" href=\"#\">\n                <i class=\"ti ti-users text-2xl\" data-kid=\"2-1-2-2-1\" data-name=\"users icon\">\n                </i>\n            </a>\n            <a class=\"nav-item group relative py-5 flex justify-center text-gray-400 hover:text-white hover:bg-white/5\" data-kid=\"2-1-2-3\" data-name=\"chart navigation link\" href=\"#\">\n                <i class=\"ti ti-chart-bar text-2xl\" data-kid=\"2-1-2-3-1\" data-name=\"chart icon\">\n                </i>\n            </a>\n            <a class=\"nav-item group relative py-5 flex justify-center text-gray-400 hover:text-white hover:bg-white/5\" data-kid=\"2-1-2-4\" data-name=\"file navigation link\" href=\"#\">\n                <i class=\"ti ti-file-text text-2xl\" data-kid=\"2-1-2-4-1\" data-name=\"file icon\">\n                </i>\n            </a>\n            <a class=\"nav-item group relative py-5 flex justify-center text-gray-400 hover:text-white hover:bg-white/5\" data-kid=\"2-1-2-5\" data-name=\"settings navigation link\" href=\"#\">\n                <i class=\"ti ti-settings text-2xl\" data-kid=\"2-1-2-5-1\" data-name=\"settings icon\">\n                </i>\n            </a>\n        </nav>\n        <div class=\"mt-auto mb-6\" data-kid=\"2-1-3\" data-name=\"user profile wrapper\">\n            <div class=\"w-10 h-10 border border-white/40 bg-white/5 flex items-center justify-center text-white font-mono text-xs\" data-kid=\"2-1-3-1\" data-name=\"user initials badge\">\n                JD\n            </div>\n        </div>\n    </aside>\n    <!-- Main Workspace -->\n    <main class=\"flex-1 flex flex-col h-full overflow-hidden relative\" data-kid=\"2-2\" data-name=\"main content area\">\n        <!-- Header -->\n        <header class=\"h-16 bg-white border-b border-navy px-8 flex items-center justify-between shrink-0 z-40\" data-kid=\"2-2-1\" data-name=\"main header\" id=\"header\">\n            <div class=\"flex items-center gap-6\" data-kid=\"2-2-1-1\" data-name=\"header title and metadata\">\n                <div class=\"flex flex-col\" data-kid=\"2-2-1-1-1\" data-name=\"header title group\">\n                    <h1 class=\"text-sm font-black tracking-tight uppercase leading-none\" data-kid=\"2-2-1-1-1-1\" data-name=\"system title headline\">\n                        نظام المراقبة السريرية الموحد\n                    </h1>\n                    <div class=\"flex items-center gap-2 mt-1\" data-kid=\"2-2-1-1-1-2\" data-name=\"system metadata\">\n                        <span class=\"text-[11px] text-gray-500 font-mono tracking-wider uppercase border border-gray-200 px-1.5 bg-gray-50\" data-kid=\"2-2-1-1-1-2-1\" data-name=\"system ID tag\">\n                            ID: HC-992-QX\n                        </span>\n                        <span class=\"w-1 h-1 bg-gray-400 rounded-full\" data-kid=\"2-2-1-1-1-2-2\" data-name=\"metadata separator dot\">\n                        </span>\n                        <span class=\"text-[10px] font-mono text-white bg-navy px-1.5 font-bold\" data-kid=\"2-2-1-1-1-2-3\" data-name=\"system version tag\">\n                            V8.1.2\n                        </span>\n                    </div>\n                </div>\n                <div class=\"h-8 w-px bg-gray-300\" data-kid=\"2-2-1-1-2\" data-name=\"header separator line\">\n                </div>\n                <div class=\"flex items-center gap-3\" data-kid=\"2-2-1-1-3\" data-name=\"system status indicator group\">\n                    <span class=\"text-[11px] font-bold text-gray-600\" data-kid=\"2-2-1-1-3-1\" data-name=\"status label\">\n                        الحالة:\n                    </span>\n                    <div class=\"flex items-center gap-2\" data-kid=\"2-2-1-1-3-2\" data-name=\"active status indicator\">\n                        <div class=\"w-2 h-2 bg-green-500 animate-pulse\" data-kid=\"2-2-1-1-3-2-1\" data-name=\"pulsing active indicator dot\">\n                        </div>\n                        <span class=\"text-[11px] font-black uppercase tracking-tight\" data-kid=\"2-2-1-1-3-2-2\" data-name=\"status text\">\n                            SYSTEM_ACTIVE\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-8\" data-kid=\"2-2-1-2\" data-name=\"header notification area\">\n                <div class=\"flex items-center gap-4 text-xs\" data-kid=\"2-2-1-2-1\" data-name=\"date and notification group\">\n                    <div class=\"flex flex-col items-end\" data-kid=\"2-2-1-2-1-1\" data-name=\"date time display\" dir=\"ltr\">\n                        <span class=\"text-[11px] text-gray-500 font-mono uppercase font-bold\" data-kid=\"2-2-1-2-1-1-1\" data-name=\"date text\">\n                            22 May 2024\n                        </span>\n                        <span class=\"font-mono font-black text-navy text-[12px]\" data-kid=\"2-2-1-2-1-1-2\" data-name=\"time text\">\n                            14:52:04 UTC\n                        </span>\n                    </div>\n                    <button class=\"w-10 h-10 border border-navy flex items-center justify-center relative hover:bg-gray-50\" data-kid=\"2-2-1-2-1-2\" data-name=\"notification button\">\n                        <i class=\"ti ti-bell text-lg\" data-kid=\"2-2-1-2-1-2-1\" data-name=\"bell icon\">\n                        </i>\n                        <span class=\"absolute top-0 right-0 w-2 h-2 bg-red-600 border border-white\" data-kid=\"2-2-1-2-1-2-2\" data-name=\"notification count badge\">\n                        </span>\n                    </button>\n                </div>\n            </div>\n        </header>\n        <!-- Scrollable Body -->\n        <div class=\"flex-1 overflow-y-auto custom-scroll p-6 space-y-6\" data-kid=\"2-2-2\" data-name=\"scrollable dashboard content\" id=\"dashboard-content\">\n            <!-- KPI Strip -->\n            <section class=\"kpi-panel bg-white border border-navy flex divide-x divide-x-reverse divide-gray-200 shadow-xs\" data-kid=\"2-2-2-1\" data-name=\"kpi panel\">\n                <div class=\"flex-1 p-5 kpi-item\" data-kid=\"2-2-2-1-1\" data-name=\"current patients kpi card\">\n                    <div class=\"flex items-center gap-2 mb-3\" data-kid=\"2-2-2-1-1-1\" data-name=\"current patients header\">\n                        <img class=\"w-2.5 h-2.5 opacity-60\" data-kid=\"2-2-2-1-1-1-1\" data-name=\"square icon\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/square.svg\" style=\"filter: invert(10%) sepia(48%) saturate(2853%) hue-rotate(202deg) brightness(91%) contrast(100%);\"/>\n                        <span class=\"text-[11px] font-black uppercase text-gray-500 tracking-wider\" data-kid=\"2-2-2-1-1-1-2\" data-name=\"current patients label\">\n                            المرضى الحاليين\n                        </span>\n                    </div>\n                    <div class=\"text-4xl font-mono font-bold tracking-tighter text-navy\" data-kid=\"2-2-2-1-1-2\" data-name=\"current patients count\">\n                        14,208\n                    </div>\n                    <div class=\"mt-2 flex items-center justify-between\" data-kid=\"2-2-2-1-1-3\" data-name=\"current patients metadata\">\n                        <span class=\"text-[10px] font-mono text-gray-500 font-bold\" data-kid=\"2-2-2-1-1-3-1\" data-name=\"current patients sync status\" dir=\"ltr\">\n                            SYNC_STATUS: 100%\n                        </span>\n                        <span class=\"text-[10px] font-bold text-green-700 font-mono\" data-kid=\"2-2-2-1-1-3-2\" data-name=\"current patients change percentage\" dir=\"ltr\">\n                            +2.4% ▲\n                        </span>\n                    </div>\n                </div>\n                <div class=\"flex-1 p-5 kpi-item\" data-kid=\"2-2-2-1-2\" data-name=\"bed occupancy kpi card\">\n                    <div class=\"flex items-center gap-2 mb-3\" data-kid=\"2-2-2-1-2-1\" data-name=\"bed occupancy header\">\n                        <img class=\"w-2.5 h-2.5 opacity-60\" data-kid=\"2-2-2-1-2-1-1\" data-name=\"square icon\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/square.svg\" style=\"filter: invert(10%) sepia(48%) saturate(2853%) hue-rotate(202deg) brightness(91%) contrast(100%);\"/>\n                        <span class=\"text-[11px] font-black uppercase text-gray-500 tracking-wider\" data-kid=\"2-2-2-1-2-1-2\" data-name=\"bed occupancy label\">\n                            إشغال الأسرة\n                        </span>\n                    </div>\n                    <div class=\"text-4xl font-mono font-bold tracking-tighter text-navy\" data-kid=\"2-2-2-1-2-2\" data-name=\"bed occupancy percentage\">\n                        92.8\n                        <span class=\"text-xl\" data-kid=\"2-2-2-1-2-2-1\" data-name=\"percentage sign\">\n                            %\n                        </span>\n                    </div>\n                    <div class=\"mt-2 flex items-center justify-between\" data-kid=\"2-2-2-1-2-3\" data-name=\"bed occupancy metadata\">\n                        <span class=\"text-[10px] font-mono text-gray-400\" data-kid=\"2-2-2-1-2-3-1\" data-name=\"bed occupancy warning label\">\n                            CAPACITY_WARN\n                        </span>\n                        <span class=\"text-[10px] font-black text-red-600 uppercase\" data-kid=\"2-2-2-1-2-3-2\" data-name=\"bed occupancy status level\">\n                            Critical\n                        </span>\n                    </div>\n                </div>\n                <div class=\"flex-1 p-5 kpi-item\" data-kid=\"2-2-2-1-3\" data-name=\"response time kpi card\">\n                    <div class=\"flex items-center gap-2 mb-3\" data-kid=\"2-2-2-1-3-1\" data-name=\"response time header\">\n                        <img class=\"w-2.5 h-2.5 opacity-60\" data-kid=\"2-2-2-1-3-1-1\" data-name=\"square icon\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/square.svg\" style=\"filter: invert(10%) sepia(48%) saturate(2853%) hue-rotate(202deg) brightness(91%) contrast(100%);\"/>\n                        <span class=\"text-[11px] font-black uppercase text-gray-500 tracking-wider\" data-kid=\"2-2-2-1-3-1-2\" data-name=\"response time label\">\n                            وقت الاستجابة\n                        </span>\n                    </div>\n                    <div class=\"text-4xl font-mono font-bold tracking-tighter text-navy\" data-kid=\"2-2-2-1-3-2\" data-name=\"response time value\">\n                        04:12\n                    </div>\n                    <div class=\"mt-2 flex items-center justify-between\" data-kid=\"2-2-2-1-3-3\" data-name=\"response time metadata\">\n                        <span class=\"text-[10px] font-mono text-gray-500 font-bold\" data-kid=\"2-2-2-1-3-3-1\" data-name=\"response time metric label\" dir=\"ltr\">\n                            AVG_MINS_PER_NODE\n                        </span>\n                        <span class=\"text-[10px] font-bold text-green-700 font-mono\" data-kid=\"2-2-2-1-3-3-2\" data-name=\"response time change value\" dir=\"ltr\">\n                            -18s ▼\n                        </span>\n                    </div>\n                </div>\n                <div class=\"flex-1 p-5 kpi-item\" data-kid=\"2-2-2-1-4\" data-name=\"critical cases kpi card\">\n                    <div class=\"flex items-center gap-2 mb-3\" data-kid=\"2-2-2-1-4-1\" data-name=\"critical cases header\">\n                        <img class=\"w-2.5 h-2.5 opacity-60\" data-kid=\"2-2-2-1-4-1-1\" data-name=\"square icon\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/square.svg\" style=\"filter: invert(10%) sepia(48%) saturate(2853%) hue-rotate(202deg) brightness(91%) contrast(100%);\"/>\n                        <span class=\"text-[11px] font-black uppercase text-gray-500 tracking-wider\" data-kid=\"2-2-2-1-4-1-2\" data-name=\"critical cases label\">\n                            الحالات الحرجة\n                        </span>\n                    </div>\n                    <div class=\"text-4xl font-mono font-bold tracking-tighter text-navy\" data-kid=\"2-2-2-1-4-2\" data-name=\"critical cases count\">\n                        124\n                    </div>\n                    <div class=\"mt-2 flex items-center justify-between\" data-kid=\"2-2-2-1-4-3\" data-name=\"critical cases metadata\">\n                        <span class=\"text-[10px] font-mono text-gray-400\" data-kid=\"2-2-2-1-4-3-1\" data-name=\"critical cases status label\">\n                            PENDING_DISPATCH\n                        </span>\n                        <span class=\"text-[10px] font-bold text-navy font-mono\" data-kid=\"2-2-2-1-4-3-2\" data-name=\"critical cases state label\">\n                            NORMAL\n                        </span>\n                    </div>\n                </div>\n            </section>\n            <!-- Main Grid -->\n            <div class=\"grid grid-cols-12 gap-6\" data-kid=\"2-2-2-2\" data-name=\"main analytics and stats grid\">\n                <!-- Analytics -->\n                <section class=\"col-span-8 bg-white border border-navy flex flex-col shadow-sm analytics-card\" data-kid=\"2-2-2-2-1\" data-name=\"analytics efficiency card\">\n                    <div class=\"p-4 border-b border-navy flex items-center justify-between bg-white\" data-kid=\"2-2-2-2-1-1\" data-name=\"analytics header\">\n                        <h2 class=\"text-xs font-black uppercase tracking-widest border-r-4 border-navy pr-3\" data-kid=\"2-2-2-2-1-1-1\" data-name=\"analytics title\">\n                            تحليل الكفاءة السريرية\n                        </h2>\n                        <div class=\"flex border border-navy overflow-hidden font-mono\" data-kid=\"2-2-2-2-1-1-2\" data-name=\"time range selection\">\n                            <button class=\"px-3 py-1 text-[9px] font-bold bg-navy text-white\" data-kid=\"2-2-2-2-1-1-2-1\" data-name=\"24h button\">\n                                24H\n                            </button>\n                            <button class=\"px-3 py-1 text-[9px] font-bold border-r border-navy hover:bg-gray-100\" data-kid=\"2-2-2-2-1-1-2-2\" data-name=\"7d button\">\n                                7D\n                            </button>\n                            <button class=\"px-3 py-1 text-[9px] font-bold border-r border-navy hover:bg-gray-100\" data-kid=\"2-2-2-2-1-1-2-3\" data-name=\"all button\">\n                                ALL\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"flex-1 p-8 relative\" data-kid=\"2-2-2-2-1-2\" data-name=\"analytics content area\">\n                        <div class=\"absolute inset-0 grid-bg\" data-kid=\"2-