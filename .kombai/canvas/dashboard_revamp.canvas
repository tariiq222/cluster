   [2023.11.22 14:44:02]\n                                </td>\n                            </tr>\n                            <!-- Log Item 2 -->\n                            <tr class=\"hover:bg-white border-b border-gray-200\" data-kid=\"1-2-2-4-2-1-1-2\" data-name=\"log row 2\">\n                                <td class=\"p-1 px-3 font-almarai font-bold text-[var(--primary)]\" data-kid=\"1-2-2-4-2-1-1-2-1\" data-name=\"event type label\">\n                                    دورة الفحص\n                                </td>\n                                <td class=\"p-1 w-4 opacity-20 text-center\" data-kid=\"1-2-2-4-2-1-1-2-2\" data-name=\"separator\">\n                                    |\n                                </td>\n                                <td class=\"p-1 w-20\" data-kid=\"1-2-2-4-2-1-1-2-3\" data-name=\"status tag container\">\n                                    <span class=\"bg-[var(--primary)] text-white px-1 font-bold text-[7px] block text-center\" data-kid=\"1-2-2-4-2-1-1-2-3-1\" data-name=\"status tag\">\n                                        CORE_SYS\n                                    </span>\n                                </td>\n                                <td class=\"p-1 w-4 opacity-20 text-center\" data-kid=\"1-2-2-4-2-1-1-2-4\" data-name=\"separator\">\n                                    |\n                                </td>\n                                <td class=\"p-1 font-almarai opacity-80\" data-kid=\"1-2-2-4-2-1-1-2-5\" data-name=\"log message text\">\n                                    اكتمال الفحص الأمني للطبقة الثالثة. جميع العقد تعمل بكفاءة تامة.\n                                </td>\n                                <td class=\"p-1 px-3 w-32 opacity-50 text-left whitespace-nowrap\" data-kid=\"1-2-2-4-2-1-1-2-6\" data-name=\"timestamp text\">\n                                    [2023.11.22 14:43:58]\n                                </td>\n                            </tr>\n                            <!-- Log Item 3 -->\n                            <tr class=\"hover:bg-white border-b border-gray-200\" data-kid=\"1-2-2-4-2-1-1-3\" data-name=\"log row 3\">\n                                <td class=\"p-1 px-3 font-almarai font-bold text-red-600\" data-kid=\"1-2-2-4-2-1-1-3-1\" data-name=\"event type label\">\n                                    محاولة دخول\n                                </td>\n                                <td class=\"p-1 w-4 opacity-20 text-center\" data-kid=\"1-2-2-4-2-1-1-3-2\" data-name=\"separator\">\n                                    |\n                                </td>\n                                <td class=\"p-1 w-20\" data-kid=\"1-2-2-4-2-1-1-3-3\" data-name=\"status tag container\">\n                                    <span class=\"border border-red-600 text-red-600 px-1 font-bold text-[7px] block text-center\" data-kid=\"1-2-2-4-2-1-1-3-3-1\" data-name=\"status tag\">\n                                        SEC_WARN\n                                    </span>\n                                </td>\n                                <td class=\"p-1 w-4 opacity-20 text-center\" data-kid=\"1-2-2-4-2-1-1-3-4\" data-name=\"separator\">\n                                    |\n                                </td>\n                                <td class=\"p-1 font-almarai opacity-80\" data-kid=\"1-2-2-4-2-1-1-3-5\" data-name=\"log message text\">\n                                    تم رصد محاولة دخول غير مصرح بها من عنوان IP: 192.168.1.104. تم الحظر.\n                                </td>\n                                <td class=\"p-1 px-3 w-32 opacity-50 text-left whitespace-nowrap\" data-kid=\"1-2-2-4-2-1-1-3-6\" data-name=\"timestamp text\">\n                                    [2023.11.22 14:43:45]\n                                </td>\n                            </tr>\n                            <!-- Log Item 4 -->\n                            <tr class=\"hover:bg-white border-b border-gray-200\" data-kid=\"1-2-2-4-2-1-1-4\" data-name=\"log row 4\">\n                                <td class=\"p-1 px-3 font-almarai font-bold text-green-700\" data-kid=\"1-2-2-4-2-1-1-4-1\" data-name=\"event type label\">\n                                    مزامنة حساب\n                                </td>\n                                <td class=\"p-1 w-4 opacity-20 text-center\" data-kid=\"1-2-2-4-2-1-1-4-2\" data-name=\"separator\">\n                                    |\n                                </td>\n                                <td class=\"p-1 w-20\" data-kid=\"1-2-2-4-2-1-1-4-3\" data-name=\"status tag container\">\n                                    <span class=\"border border-green-600 text-green-600 px-1 font-bold text-[7px] block text-center\" data-kid=\"1-2-2-4-2-1-1-4-3-1\" data-name=\"status tag\">\n                                        USER_AC\n                                    </span>\n                                </td>\n                                <td class=\"p-1 w-4 opacity-20 text-center\" data-kid=\"1-2-2-4-2-1-1-4-4\" data-name=\"separator\">\n                                    |\n                                </td>\n                                <td class=\"p-1 font-almarai opacity-80\" data-kid=\"1-2-2-4-2-1-1-4-5\" data-name=\"log message text\">\n                                    المشرف \"Ahmed_V4\" قام بتعديل صلاحيات الوصول للمجموعة المركزية.\n                                </td>\n                                <td class=\"p-1 px-3 w-32 opacity-50 text-left whitespace-nowrap\" data-kid=\"1-2-2-4-2-1-1-4-6\" data-name=\"timestamp text\">\n                                    [2023.11.22 14:43:21]\n                                </td>\n                            </tr>\n                            <!-- Log Item 5 -->\n                            <tr class=\"hover:bg-white border-b border-gray-200\" data-kid=\"1-2-2-4-2-1-1-5\" data-name=\"log row 5\">\n                                <td class=\"p-1 px-3 font-almarai font-bold text-[var(--primary)]\" data-kid=\"1-2-2-4-2-1-1-5-1\" data-name=\"event type label\">\n                                    تصدير تقرير\n                                </td>\n                                <td class=\"p-1 w-4 opacity-20 text-center\" data-kid=\"1-2-2-4-2-1-1-5-2\" data-name=\"separator\">\n                                    |\n                                </td>\n                                <td class=\"p-1 w-20\" data-kid=\"1-2-2-4-2-1-1-5-3\" data-name=\"status tag container\">\n                                    <span class=\"border border-[var(--primary)] px-1 font-bold text-[7px] block text-center\" data-kid=\"1-2-2-4-2-1-1-5-3-1\" data-name=\"status tag\">\n                                        DATA_OUT\n                                    </span>\n                                </td>\n                                <td class=\"p-1 w-4 opacity-20 text-center\" data-kid=\"1-2-2-4-2-1-1-5-4\" data-name=\"separator\">\n                                    |\n                                </td>\n                                <td class=\"p-1 font-almarai opacity-90\" data-kid=\"1-2-2-4-2-1-1-5-5\" data-name=\"log message text\">\n                                    تصدير التقرير الربع سنوي بصيغة PDF. المعرف المرجعي: EXP_00912.\n                                </td>\n                                <td class=\"p-1 px-3 w-32 opacity-50 text-left whitespace-nowrap\" data-kid=\"1-2-2-4-2-1-1-5-6\" data-name=\"timestamp text\">\n                                    [2023.11.22 14:42:59]\n                                </td>\n                            </tr>\n                            <!-- Log Item 6 -->\n                            <tr class=\"hover:bg-white border-b border-gray-200\" data-kid=\"1-2-2-4-2-1-1-6\" data-name=\"log row 6\">\n                                <td class=\"p-1 px-3 font-almarai font-bold text-blue-600\" data-kid=\"1-2-2-4-2-1-1-6-1\" data-name=\"event type label\">\n                                    اتصال خارجي\n                                </td>\n                                <td class=\"p-1 w-4 opacity-20 text-center\" data-kid=\"1-2-2-4-2-1-1-6-2\" data-name=\"separator\">\n                                    |\n                                </td>\n                                <td class=\"p-1 w-20\" data-kid=\"1-2-2-4-2-1-1-6-3\" data-name=\"status tag container\">\n                                    <span class=\"border border-blue-600 text-blue-600 px-1 font-bold text-[7px] block text-center\" data-kid=\"1-2-2-4-2-1-1-6-3-1\" data-name=\"status tag\">\n                                        SYNCING\n                                    </span>\n                                </td>\n                                <td class=\"p-1 w-4 opacity-20 text-center\" data-kid=\"1-2-2-4-2-1-1-6-4\" data-name=\"separator\">\n                                    |\n                                </td>\n                                <td class=\"p-1 font-almarai opacity-80\" data-kid=\"1-2-2-4-2-1-1-6-5\" data-name=\"log message text\">\n                                    جاري مزامنة قواعد البيانات مع الخادم الاحتياطي \"Region_A_Secondary\".\n                                </td>\n                                <td class=\"p-1 px-3 w-32 opacity-50 text-left whitespace-nowrap\" data-kid=\"1-2-2-4-2-1-1-6-6\" data-name=\"timestamp text\">\n                                    [2023.11.22 14:42:15]\n                                </td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n                <footer class=\"h-6 bg-gray-100 border-t border-[var(--primary)] px-3 flex items-center justify-between font-fira text-[8px] font-bold\" data-kid=\"1-2-2-4-3\" data-name=\"log footer bar\">\n                    <div class=\"flex gap-4\" data-kid=\"1-2-2-4-3-1\" data-name=\"log statistics group\">\n                        <span data-kid=\"1-2-2-4-3-1-1\" data-name=\"line count text\">\n                            LINE_COUNT: 42,091\n                        </span>\n                        <span data-kid=\"1-2-2-4-3-1-2\" data-name=\"stream status text\">\n                            STATUS: STREAMING_ACTIVE\n                        </span>\n                    </div>\n                    <div data-kid=\"1-2-2-4-3-2\" data-name=\"page pagination text\">\n                        PAGE_01_OF_102\n                    </div>\n                </footer>\n            </section>\n        </main>\n    </div>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n    </script>\n    <script>\n        document.addEventListener('DOMContentLoaded', () => {\n      // Entry Animation\n      gsap.from(\"#kpi-matrix .p-3\", {\n        opacity: 0,\n        y: 20,\n        stagger: 0.1,\n        duration: 0.8,\n        ease: \"power2.out\"\n      });\n\n      gsap.from(\"header\", {\n        y: -40,\n        opacity: 0,\n        duration: 0.6,\n        ease: \"power2.out\"\n      });\n\n      gsap.from(\"#sidebar\", {\n        x: 40,\n        opacity: 0,\n        duration: 0.6,\n        ease: \"power2.out\"\n      });\n\n      gsap.from(\"#log-body tr\", {\n        opacity: 0,\n        x: -20,\n        stagger: 0.05,\n        duration: 0.5,\n        delay: 0.4,\n        ease: \"power2.out\"\n      });\n\n      // Simple hover effect for KPIs\n      document.querySelectorAll('#kpi-matrix .p-3').forEach(card => {\n        card.addEventListener('mouseenter', () => {\n            gsap.to(card, { backgroundColor: '#F1F5F9', duration: 0.2 });\n        });\n        card.addEventListener('mouseleave', () => {\n            gsap.to(card, { backgroundColor: '#FFFFFF', duration: 0.2 });\n        });\n      });\n    });\n    </script>\n</div>\n",
      "comments": [],
      "created": "2026-07-18T14:22:21.737141+00:00",
      "modified": "2026-07-18T14:22:21.737141+00:00",
