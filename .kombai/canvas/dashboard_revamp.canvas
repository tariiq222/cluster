ems-stretch\" data-kid=\"2-2-2-2-2\" data-name=\"analytics content grid\">\n                    <!-- Left: Status Bars -->\n                    <div class=\"xl:col-span-7 pl-16\" data-kid=\"2-2-2-2-2-1\" data-name=\"department efficiency section\">\n                        <div class=\"flex items-center justify-between mb-10\" data-kid=\"2-2-2-2-2-1-1\" data-name=\"efficiency header container\">\n                            <h2 class=\"text-3xl font-bold text-[var(--deep-navy)]\" data-kid=\"2-2-2-2-2-1-1-1\" data-name=\"efficiency section title\">\n                                كفاءة الأقسام والخدمات\n                            </h2>\n                            <div class=\"flex gap-1 p-1 bg-white/30 backdrop-blur-md\" data-kid=\"2-2-2-2-2-1-1-2\" data-name=\"time period filter button group\">\n                                <button class=\"px-5 py-2 bg-white text-xs font-bold uppercase shadow-sm\" data-kid=\"2-2-2-2-2-1-1-2-1\" data-name=\"daily filter button\">\n                                    يومي\n                                </button>\n                                <button class=\"px-5 py-2 hover:bg-white/50 text-xs font-bold uppercase transition-colors\" data-kid=\"2-2-2-2-2-1-1-2-2\" data-name=\"weekly filter button\">\n                                    أسبوعي\n                                </button>\n                            </div>\n                        </div>\n                        <div class=\"space-y-10\" data-kid=\"2-2-2-2-2-1-2\" data-name=\"efficiency bar chart rows\">\n                            <div class=\"bar-row\" data-kid=\"2-2-2-2-2-1-2-1\" data-name=\"emergency department bar row\">\n                                <div class=\"flex justify-between mb-3 items-end\" data-kid=\"2-2-2-2-2-1-2-1-1\" data-name=\"emergency department bar header\">\n                                    <span class=\"font-bold text-sm uppercase tracking-wide opacity-70\" data-kid=\"2-2-2-2-2-1-2-1-1-1\" data-name=\"emergency department label\"