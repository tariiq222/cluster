        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;600;700&display=swap');\n\n  :root {\n    --radius-control: 12px;\n    --radius-surface: 16px;\n    --radius-pill: 999px;\n    --control-height: 44px;\n    --control-height-compact: 40px;\n    --badge-height: 28px;\n    --shadow-rest: none;\n    --shadow-float: 0 6px 22px rgb(11 47 58 / 12%);\n    --color-bg: #f2fafc;\n    --color-text: #0b2f3a;\n    --color-brand: #006d8f;\n    --color-border: #cdeef7;\n  }\n\n  body {\n    margin: 0;\n    font-family: 'IBM Plex Sans Arabic', sans-serif;\n    background-color: var(--color-bg);\n    color: var(--color-text);\n    direction: rtl;\n  }\n\n  .app-layout {\n    display: grid;\n    grid-template-columns: 280px 1fr;\n    min-height: 100vh;\n  }\n\n  .sidebar {\n    background: #fff;\n    border-left: 1px solid var(--color-border);\n    padding: 24px;\n  }\n\n  .main-content {\n    padding: 40px;\n    max-width: 1200px;\n    margin: 0 auto;\n    width: 100%;\n  }\n\n  .dashboard-welcome {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-bottom: 40px;\n  }\n\n  .dashboard-welcome h1 {\n    font-size: 32px;\n    font-weight: 700;\n    margin: 0;\n  }\n\n  .dashboard-welcome p {\n    color: #496a75;\n    font-size: 14px;\n    margin: 8px 0 0;\n  }\n\n  .scope-badge {\n    display: inline-flex;\n    height: var(--badge-height);\n    align-items: center;\n    padding: 0 12px;\n    border: 1px solid #9bd6e2;\n    border-radius: var(--radius-pill);\n    color: #005a77;\n    background: #e6f7fa;\n    font-size: 12px;\n    font-weight: 600;\n    margin-left: 12px;\n  }\n\n  .range-indicator {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    padding: 8px 16px;\n    border: 1px solid var(--color-border);\n    border-radius: var(--radius-control);\n    background: #fff;\n    font-size: 13px;\n    color: #496a75;\n  }\n\n  .section-heading {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-bottom: 16px;\n    padding-bottom: 12px;\n    border-bottom: 1px solid var(--color-border);\n    position: relative;\n  }\n\n  .section-heading::after {\n    content: '';\n    position: absolute;\n    bottom: -1px;\n    right: 0;\n    width: 120px;\n    height: 1px;\n    background: #00b4d8;\n  }\n\n  .section-heading h2 {\n    font-size: 20px;\n    font-weight: 700;\n    margin: 0;\n  }\n\n  .kpi-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 16px;\n    margin-bottom: 40px;\n  }\n\n  .kpi-card {\n    background: #fff;\n    border: 1px solid var(--color-border);\n    border-radius: var(--radius-surface);\n    padding: 20px;\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n  }\n\n  .kpi-label {\n    font-size: 12px;\n    color: #496a75;\n    display: flex;\n    align-items: center;\n    gap: 6px;\n  }\n\n  .kpi-dot {\n    width: 8px;\n    height: 8px;\n    border-radius: 50%;\n  }\n\n  .kpi-value {\n    font-size: 28px;\n    font-weight: 700;\n    color: #0077b6;\n  }\n\n  .kpi-source {\n    font-size: 11px;\n    color: #607b85;\n    margin-top: auto;\n  }\n\n  .panel-grid {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 24px;\n    margin-bottom: 40px;\n  }\n\n  .panel {\n    background: #fff;\n    border: 1px solid var(--color-border);\n    border-radius: var(--radius-surface);\n    padding: 24px;\n    min-height: 320px;\n  }\n\n  .panel-header {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-bottom: 20px;\n  }\n\n  .panel-header h3 {\n    font-size: 16px;\n    font-weight: 600;\n    margin: 0;\n    color: #365d6b;\n  }\n\n  .panel-link {\n    font-size: 13px;\n    font-weight: 600;\n    color: #0077b6;\n    text-decoration: none;\n  }\n\n  .empty-state {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    height: 200px;\n    text-align: center;\n    color: #496a75;\n  }\n\n  .empty-icon {\n    width: 48px;\n    height: 48px;\n    background: #eef9fc;\n    border-radius: 12px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin-bottom: 16px;\n  }\n\n  .status-row {\n    margin-bottom: 20px;\n  }\n\n  .status-info {\n    display: flex;\n    justify-content: space-between;\n    margin-bottom: 8px;\n    font-size: 14px;\n  }\n\n  .progress-bar {\n    height: 8px;\n    background: #eef7f9;\n    border-radius: 4px;\n    overflow: hidden;\n  }\n\n  .progress-fill {\n    height: 100%;\n    border-radius: 4px;\n  }\n\n  .list-item {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding: 16px 0;\n    border-bottom: 1px solid var(--color-border);\n  }\n\n  .list-item:last-child {\n    border-bottom: none;\n  }\n\n  .item-content {\n    display: flex;\n    flex-direction: column;\n    gap: 4px;\n  }\n\n  .item-title {\n    font-weight: 600;\n    font-size: 14px;\n  }\n\n  .item-desc {\n    font-size: 13px;\n    color: #546166;\n  }\n\n  .item-meta {\n    display: flex;\n    flex-direction: column;\n    align-items: flex-end;\n    gap: 4px;\n    font-size: 12px;\n    color: #607b85;\n  }\n\n  .badge {\n    padding: 2px 8px;\n    border-radius: 12px;\n    font-size: 11px;\n    font-weight: 600;\n    background: #e8f3f1;\n    color: #005d59;\n    border: 1px solid #006c67;\n  }\n</style>\n<div class=\"app-layout\" data-kid=\"1\" data-name=\"dashboard app layout\">\n    <aside class=\"sidebar\" data-kid=\"1-1\" data-name=\"sidebar navigation menu\">\n        <div data-kid=\"1-1-1\" data-name=\"app brand logo area\" style=\"font-weight: 700; font-size: 18px; margin-bottom: 32px; color: var(--color-brand);\">\n            <i class=\"lucide-shield-check\" data-kid=\"1-1-1-1\" data-name=\"shield check icon\" style=\"margin-left: 8px;\">\n            </i>\n            منصة التجمع الثالث\n        </div>\n        <nav data-kid=\"1-1-2\" data-name=\"navigation links container\">\n            <div data-kid=\"1-1-2-1\" data-name=\"active dashboard link\" style=\"padding: 12px; background: #eef9fc; border-radius: 8px; color: var(--color-brand); font-weight: 600; margin-bottom: 8px;\">\n                <i class=\"lucide-layout-dashboard\" data-kid=\"1-1-2-1-1\" data-name=\"dashboard icon\" style=\"margin-left: 12px;\">\n                </i>\n                الرئيسية\n            </div>\n            <div data-kid=\"1-1-2-2\" data-name=\"my orders navigation link\" style=\"padding: 12px; border-radius: 8px; color: #496a75; margin-bottom: 8px;\">\n                <i class=\"lucide-clipboard-list\" data-kid=\"1-1-2-2-1\" data-name=\"clipboard list icon\" style=\"margin-left: 12px;\">\n                </i>\n                طلباتي\n            </div>\n            <div data-kid=\"1-1-2-3\" data-name=\"notifications navigation link\" style=\"padding: 12px; border-radius: 8px; color: #496a75; margin-bottom: 8px;\">\n                <i class=\"lucide-bell\" data-kid=\"1-1-2-3-1\" data-name=\"bell icon\" style=\"margin-left: 12px;\">\n                </i>\n                الإشعارات\n            </div>\n        </nav>\n    </aside>\n    <main class=\"main-content\" data-kid=\"1-2\" data-name=\"main content area\">\n        <header class=\"dashboard-welcome\" data-kid=\"1-2-1\" data-name=\"welcome header section\">\n            <div data-kid=\"1-2-1-1\" data-name=\"user welcome message container\">\n                <h1 data-kid=\"1-2-1-1-1\" data-name=\"user greeting headline\">\n                    مرحباً بك، طارق\n                </h1>\n                <p data-kid=\"1-2-1-1-2\" data-name=\"welcome subtext with scope\">\n                    <span class=\"scope-badge\" data-kid=\"1-2-1-1-2-1\" data-name=\"scope badge label\">\n                        المنشأة أ\n                    </span>\n                    إليك ملخص الطلبات والإشعارات ضمن نطاق المنشأة الحالية.\n                </p>\n            </div>\n            <div class=\"range-indicator\" data-kid=\"1-2-1-2\" data-name=\"range indicator widget\">\n                <i class=\"lucide-calendar-days\" data-kid=\"1-2-1-2-1\" data-name=\"calendar icon\">\n                </i>\n                حد العرض: ٢٠ طلباً\n            </div>\n        </header>\n        <section data-kid=\"1-2-2\" data-name=\"KPI overview section\">\n            <div class=\"section-heading\" data-kid=\"1-2-2-1\" data-name=\"section heading\">\n                <h2 data-kid=\"1-2-2-1-1\" data-name=\"section title\">\n                    نظرة عامة\n                </h2>\n            </div>\n            <div class=\"kpi-grid\" data-kid=\"1-2-2-2\" data-name=\"KPI summary grid\">\n                <div class=\"kpi-card\" data-kid=\"1-2-2-2-1\" data-name=\"kpi card\">\n                    <div class=\"kpi-label\" data-kid=\"1-2-2-2-1-1\" data-name=\"kpi label container\">\n                        <span class=\"kpi-dot\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"colored indicator dot\" style=\"background: #0077b6;\">\n                        </span>\n                        الطلبات المحمّلة\n                    </div>\n                    <div class=\"kpi-value\" data-kid=\"1-2-2-2-1-2\" data-name=\"kpi numeric value\">\n                        ٤٢\n                    </div>\n                    <div class=\"kpi-source\" data-kid=\"1-2-2-2-1-3\" data-name=\"kpi data source label\">\n                        من النتائج المحمّلة\n                    </div>\n                </div>\n                <div class=\"kpi-card\" data-kid=\"1-2-2-2-2\" data-name=\"kpi card\">\n                    <div class=\"kpi-label\" data-kid=\"1-2-2-2-2-1\" data-name=\"kpi label container\">\n                        <span class=\"kpi-dot\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"colored indicator dot\" style=\"background: #00b4d8;\">\n                        </span>\n                        طلبات قيد الإجراء\n                    </div>\n                    <div class=\"kpi-value\" data-kid=\"1-2-2-2-2-2\" data-name=\"kpi numeric value\">\n                        ١٢\n                    </div>\n                    <div class=\"kpi-source\" data-kid=\"1-2-2-2-2-3\" data-name=\"kpi data source label\">\n                        من النتائج المحمّلة\n                    </div>\n                </div>\n                <div class=\"kpi-card\" data-kid=\"1-2-2-2-3\" data-name=\"kpi card\">\n                    <div class=\"kpi-label\" data-kid=\"1-2-2-2-3-1\" data-name=\"kpi label container\">\n                        <span class=\"kpi-dot\" data-kid=\"1-2-2-2-3-1-1\" data-name=\"colored indicator dot\" style=\"background: #247a42;\">\n                        </span>\n                        طلبات مكتملة\n                    </div>\n                    <div class=\"kpi-value\" data-kid=\"1-2-2-2-3-2\" data-name=\"kpi numeric value\">\n                        ٢٨\n                    </div>\n                    <div class=\"kpi-source\" data-kid=\"1-2-2-2-3-3\" data-name=\"kpi data source label\">\n                        من النتائج المحمّلة\n                    </div>\n                </div>\n                <div class=\"kpi-card\" data-kid=\"1-2-2-2-4\" data-name=\"kpi card\">\n                    <div class=\"kpi-label\" data-kid=\"1-2-2-2-4-1\" data-name=\"kpi label container\">\n                        <span class=\"kpi-dot\" data-kid=\"1-2-2-2-4-1-1\" data-name=\"colored indicator dot\" style=\"background: #829ba4;\">\n                        </span>\n                        إشعارات غير مقروءة\n                    </div>\n                    <div class=\"kpi-value\" data-kid=\"1-2-2-2-4-2\" data-name=\"kpi numeric value\">\n                        ٥\n                    </div>\n                    <div class=\"kpi-source\" data-kid=\"1-2-2-2-4-3\" data-name=\"kpi data source label\">\n                        من إشعارات المستخدم\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section data-kid=\"1-2-3\" data-name=\"analytics section\">\n            <div class=\"section-heading\" data-kid=\"1-2-3-1\" data-name=\"section heading\">\n                <h2 data-kid=\"1-2-3-1-1\" data-name=\"section title\">\n                    التحليلات\n                </h2>\n            </div>\n            <div class=\"panel-grid\" data-kid=\"1-2-3-2\" data-name=\"analytics panel grid\">\n                <div class=\"panel\" data-kid=\"1-2-3-2-1\" data-name=\"time analytics panel\">\n                    <div class=\"panel-header\" data-kid=\"1-2-3-2-1-1\" data-name=\"panel header\">\n                        <h3 data-kid=\"1-2-3-2-1-1-1\" data-name=\"panel title\">\n                            التحليلات الزمنية\n                        </h3>\n                    </div>\n                    <div class=\"empty-state\" data-kid=\"1-2-3-2-1-2\" data-name=\"empty state content container\">\n                        <div class=\"empty-icon\" data-kid=\"1-2-3-2-1-2-1\" data-name=\"empty icon container\">\n                            <i class=\"lucide-folder-search\" data-kid=\"1-2-3-2-1-2-1-1\" data-name=\"folder search icon\">\n                            </i>\n                        </div>\n                        <div data-kid=\"1-2-3-2-1-2-2\" data-name=\"empty state headline\" style=\"font-weight: 600; color: #0077b6; margin-bottom: 4px;\">\n                            لا تتوفر سلسلة زمنية بعد\n                        </div>\n                        <p data-kid=\"1-2-3-2-1-2-3\" data-name=\"empty state description\">\n                            ستظهر اتجاهات الطلبات عند نشر مصدر التجميع الزمني المعتمد.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"panel\" data-kid=\"1-2-3-2-2\" data-name=\"status analytics panel\">\n                    <div class=\"panel-header\" data-kid=\"1-2-3-2-2-1\" data-name=\"panel header\">\n                        <h3 data-kid=\"1-2-3-2-2-1-1\" data-name=\"panel title\">\n                            الطلبات حسب الحالة\n                        </h3>\n                    </div>\n                    <div class=\"status-row\" data-kid=\"1-2-3-2-2-2\" data-name=\"status progress row\">\n                        <div class=\"status-info\" data-kid=\"1-2-3-2-2-2-1\" data-name=\"status info header\">\n                            <span data-kid=\"1-2-3-2-2-2-1-1\" data-name=\"status label\">\n                                قيد الإجراء\n                            </span>\n                            <strong data-kid=\"1-2-3-2-2-2-1-2\" data-name=\"status count\">\n                                ١٢\n                            </strong>\n                        </div>\n                        <div class=\"progress-bar\" data-kid=\"1-2-3-2-2-2-2\" data-name=\"progress bar track\">\n                            <div class=\"progress-fill\" data-kid=\"1-2-3-2-2-2-2-1\" data-name=\"progress fill bar\" style=\"width: 30%; background: #00b4d8;\">\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"status-row\" data-kid=\"1-2-3-2-2-3\" data-name=\"status progress row\">\n                        <div class=\"status-info\" data-kid=\"1-2-3-2-2-3-1\" data-name=\"status info header\">\n                            <span data-kid=\"1-2-3-2-2-3-1-1\" data-name=\"status label\">\n                                مكتملة\n                            </span>\n                            <strong data-kid=\"1-2-3-2-2-3-1-2\" data-name=\"status count\">\n                                ٢٨\n                            </strong>\n                        </div>\n                        <div class=\"progress-bar\" data-kid=\"1-2-3-2-2-3-2\" data-name=\"progress bar track\">\n                            <div class=\"progress-fill\" data-kid=\"1-2-3-2-2-3-2-1\" data-name=\"progress fill bar\" style=\"width: 65%; background: #247a42;\">\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"status-row\" data-kid=\"1-2-3-2-2-4\" data-name=\"status progress row\">\n                        <div class=\"status-info\" data-kid=\"1-2-3-2-2-4-1\" data-name=\"status info header\">\n                            <span data-kid=\"1-2-3-2-2-4-1-1\" data-name=\"status label\">\n                                حالات أخرى\n                            </span>\n                            <strong data-kid=\"1-2-3-2-2-4-1-2\" data-name=\"status count\">\n                                ٢\n                            </strong>\n                        </div>\n                        <div class=\"progress-bar\" data-kid=\"1-2-3-2-2-4-2\" data-name=\"progress bar track\">\n                            <div class=\"progress-fill\" data-kid=\"1-2-3-2-2-4-2-1\" data-name=\"progress fill bar\" style=\"width: 5%; background: #829ba4;\">\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section data-kid=\"1-2-4\" data-name=\"activity section\">\n            <div class=\"section-heading\" data-kid=\"1-2-4-1\" data-name=\"section heading\">\n                <h2 data-kid=\"1-2-4-1-1\" data-name=\"section title\">\n                    النشاط المتاح\n                </h2>\n            </div>\n            <div class=\"panel-grid\" data-kid=\"1-2-4-2\" data-name=\"activity panel grid\">\n                <div class=\"panel\" data-kid=\"1-2-4-2-1\" data-name=\"orders panel\">\n                    <div class=\"panel-header\" data-kid=\"1-2-4-2-1-1\" data-name=\"panel header\">\n                        <h3 data-kid=\"1-2-4-2-1-1-1\" data-name=\"panel title\">\n                            طلباتي\n                        </h3>\n                        <a class=\"panel-link\" data-kid=\"1-2-4-2-1-1-2\" data-name=\"create new order link\" href=\"#\">\n                            طلب جديد\n                        </a>\n                    </div>\n                    <div class=\"list-item\" data-kid=\"1-2-4-2-1-2\" data-name=\"list item\">\n                        <div class=\"item-content\" data-kid=\"1-2-4-2-1-2-1\" data-name=\"item content container\">\n                            <div class=\"item-title\" data-kid=\"1-2-4-2-1-2-1-1\" data-name=\"item title\">\n                                طلب صيانة أجهزة\n                            </div>\n                            <div class=\"item-desc\" data-kid=\"1-2-4-2-1-2-1-2\" data-name=\"item description\">\n                                صيانة دورية لقسم الطوارئ\n                            </div>\n                        </div>\n                        <div class=\"item-meta\" data-kid=\"1-2-4-2-1-2-2\" data-name=\"item metadata container\">\n                            <span class=\"badge\" data-kid=\"1-2-4-2-1-2-2-1\" data-name=\"status badge\">\n                                قيد المراجعة\n                            </span>\n                            <time data-kid=\"1-2-4-2-1-2-2-2\" data-name=\"item timestamp\">\n                                ١٥ يوليو ٢٠٢٦\n                            </time>\n                        </div>\n                    </div>\n                    <div class=\"list-item\" data-kid=\"1-2-4-2-1-3\" data-name=\"list item\">\n                        <div class=\"item-content\" data-kid=\"1-2-4-2-1-3-1\" data-name=\"item content container\">\n                            <div class=\"item-title\" data-kid=\"1-2-4-2-1-3-1-1\" data-name=\"item title\">\n                                توفير مستلزمات طبية\n                            </div>\n                            <div class=\"item-desc\" data-kid=\"1-2-4-2-1-3-1-2\" data-name=\"item description\">\n                                طلب شاش ومعقمات\n                            </div>\n                        </div>\n                        <div class=\"item-meta\" data-kid=\"1-2-4-2-1-3-2\" data-name=\"item metadata container\">\n                            <span class=\"badge\" data-kid=\"1-2-4-2-1-3-2-1\" data-name=\"status badge\" style=\"background: #f0fdf4; color: #166534; border-color: #bbf7d0;\">\n                                مكتمل\n                            </span>\n                            <time data-kid=\"1-2-4-2-1-3-2-2\" data-name=\"item timestamp\">\n                                ١٢ يوليو ٢٠٢٦\n                            </time>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"panel\" data-kid=\"1-2-4-2-2\" data-name=\"notifications panel\">\n                    <div class=\"panel-header\" data-kid=\"1-2-4-2-2-1\" data-name=\"panel header\">\n                        <h3 data-kid=\"1-2-4-2-2-1-1\" data-name=\"panel title\">\n                            الإشعارات\n                        </h3>\n                        <a class=\"panel-link\" data-kid=\"1-2-4-2-2-1-2\" data-name=\"view all link\" href=\"#\">\n                            عرض الكل\n                        </a>\n                    </div>\n                    <div class=\"list-item\" data-kid=\"1-2-4-2-2-2\" data-name=\"list item\">\n                        <div class=\"item-content\" data-kid=\"1-2-4-2-2-2-1\" data-name=\"item content container\">\n                            <div class=\"item-title\" data-kid=\"1-2-4-2-2-2-1-1\" data-name=\"item title\">\n                                تحديث على طلب الصيانة\n                            </div>\n                            <div class=\"item-desc\" data-kid=\"1-2-4-2-2-2-1-2\" data-name=\"item description\">\n                                تم قبول طلبك وجاري التنفيذ\n                            </div>\n                        </div>\n                        <div class=\"item-meta\" data-kid=\"1-2-4-2-2-2-2\" data-name=\"item metadata container\">\n                            <span data-kid=\"1-2-4-2-2-2-2-1\" data-name=\"notification status indicator\" style=\"color: #0077b6; font-weight: 600;\">\n                                غير مقروء\n                            </span>\n                            <time data-kid=\"1-2-4-2-2-2-2-2\" data-name=\"notification timestamp\">\n                                منذ ساعة\n                            </time>\n                        </div>\n                    </div>\n                    <div class=\"list-item\" data-kid=\"1-2-4-2-2-3\" data-name=\"list item\">\n                        <div class=\"item-content\" data-kid=\"1-2-4-2-2-3-1\" data-name=\"item content container\">\n                            <div class=\"item-title\" data-kid=\"1-2-4-2-2-3-1-1\" data-name=\"item title\">\n                                تقرير الأداء الشهري\n                            </div>\n                            <div class=\"item-desc\" data-kid=\"1-2-4-2-2-3-1-2\" data-name=\"item description\">\n                                التقرير جاهز للمراجعة\n                            </div>\n                        </div>\n                        <div class=\"item-meta\" data-kid=\"1-2-4-2-2-3-2\" data-name=\"item metadata container\">\n                            <span data-kid=\"1-2-4-2-2-3-2-1\" data-name=\"notification status indicator\">\n                                مقروء\n                            </span>\n                            <time data-kid=\"1-2-4-2-2-3-2-2\" data-name=\"notification timestamp\">\n                                منذ يومين\n                            </time>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    lucide.createIcons();\n</script>\n",
      "comments": [],
      "created": "2026-07-18T14:18:04.891885+00:00",
      "modified": "2026-07-18T14:18:30.932849+00:00",
      "id": "var_179ba27de628"
    },
    "var_205f2e1b1bcd": {
      "type": "variant",
      "label": "Institutional Clarity: Monolithic Data Interface",
      "parentId": "var_179ba27de628",
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<div class=\"min-h-screen bg-[#E5E7EB] text-[#0F172A] font-almarai overflow-x-clip select-none\" data-kid=\"1\" data-name=\"page layout container\" dir=\"rtl\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Almarai:wght@300;400;700;800&family=Fira+Code:wght@300..700&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    :root {\n      --primary: #0F172A;\n      --bg-slate: #E5E7EB;\n      --container: #F9FAFB;\n      --accent: #2563EB;\n    }\n\n    body {\n      margin: 0;\n      padding: 0;\n      background-color: var(--bg-slate);\n    }\n\n    .font-fira { font-family: 'Fira Code', monospace; }\n    \n    .grid-bg {\n      background-image: radial-gradient(var(--primary) 0.5px, transparent 0.5px);\n      background-size: 20px 20px;\n      opacity: 0.03;\n    }\n\n    .monolith-border {\n      border: 1px solid var(--primary);\n    }\n\n    .coordinate-tag {\n      position: absolute;\n      font-family: 'Fira Code', monospace;\n      font-size: 8px;\n      opacity: 0.2;\n      pointer-events: none;\n      font-weight: bold;\n    }\n\n    .stark-grid td, .stark-grid div {\n      border-color: var(--primary);\n    }\n\n    /* Scrollbar Styling */\n    .custom-scroll::-webkit-scrollbar {\n      width: 4px;\n    }\n    .custom-scroll::-webkit-scrollbar-track {\n      background: transparent;\n    }\n    .custom-scroll::-webkit-scrollbar-thumb {\n      background: var(--primary);\n    }\n\n    .segmented-bar-segment {\n      height: 100%;\n      width: 4px;\n      margin-left: 2px;\n      background-color: var(--primary);\n    }\n    .segmented-bar-segment.empty {\n      background-color: rgba(15, 23, 42, 0.1);\n    }\n\n    .scanline {\n      width: 100%;\n      height: 100px;\n      z-index: 10;\n      background: linear-gradient(0deg, rgba(37, 99, 235, 0.05) 0%, rgba(255, 255, 255, 0) 100%);\n      position: absolute;\n      bottom: 100%;\n      animation: scan 8s linear infinite;\n      pointer-events: none;\n    }\n\n    @keyframes scan {\n      0% { bottom: 100%; }\n      100% { bottom: -100px; }\n    }\n    </style>\n    <!-- Background Overlay -->\n    <div class=\"fixed inset-0 grid-bg pointer-events-none\" data-kid=\"1-1\" data-name=\"background grid overlay\">\n    </div>\n    <div class=\"relative flex h-screen p-3 gap-3\" data-kid=\"1-2\" data-name=\"application layout wrapper\">\n        <!-- Sidebar: Ultra-slim Icon Rail (Right side for RTL) -->\n        <aside class=\"w-12 monolith-border bg-white flex flex-col items-center py-4 gap-6 z-20 hover:w-16 hover:transition-[width] hover:duration-200 group\" data-kid=\"1-2-1\" data-name=\"sidebar navigation rail\" id=\"sidebar\">\n            <div class=\"w-8 h-8 bg-[var(--primary)] flex items-center justify-center text-white mb-4 group-hover:scale-110 transition-transform\" data-kid=\"1-2-1-1\" data-name=\"terminal logo icon container\">\n                <i class=\"ti ti-terminal text-lg\" data-kid=\"1-2-1-1-1\" data-name=\"terminal logo icon\">\n                </i>\n            </div>\n            <nav class=\"flex flex-col gap-5 text-[var(--primary)] opacity-40\" data-kid=\"1-2-1-2\" data-name=\"navigation link group\">\n                <div class=\"p-2 opacity-100 border border-[var(--primary)] cursor-pointer\" data-kid=\"1-2-1-2-1\" data-name=\"dashboard navigation link\">\n                    <i class=\"ti ti-layout-dashboard text-lg\" data-kid=\"1-2-1-2-1-1\" data-name=\"dashboard icon\">\n                    </i>\n                </div>\n                <div class=\"p-2 hover:opacity-100 cursor-pointer\" data-kid=\"1-2-1-2-2\" data-name=\"database navigation link\">\n                    <i class=\"ti ti-database text-lg\" data-kid=\"1-2-1-2-2-1\" data-name=\"database icon\">\n                    </i>\n                </div>\n                <div class=\"p-2 hover:opacity-100 cursor-pointer\" data-kid=\"1-2-1-2-3\" data-name=\"chart navigation link\">\n                    <i class=\"ti ti-chart-bar text-lg\" data-kid=\"1-2-1-2-3-1\" data-name=\"chart icon\">\n                    </i>\n                </div>\n                <div class=\"p-2 hover:opacity-100 cursor-pointer\" data-kid=\"1-2-1-2-4\" data-name=\"users navigation link\">\n                    <i class=\"ti ti-users text-lg\" data-kid=\"1-2-1-2-4-1\" data-name=\"users icon\">\n                    </i>\n                </div>\n                <div class=\"p-2 hover:opacity-100 cursor-pointer\" data-kid=\"1-2-1-2-5\" data-name=\"mail navigation link\">\n                    <i class=\"ti ti-mail text-lg\" data-kid=\"1-2-1-2-5-1\" data-name=\"mail icon\">\n                    </i>\n                </div>\n                <div class=\"p-2 hover:opacity-100 cursor-pointer\" data-kid=\"1-2-1-2-6\" data-name=\"settings navigation link\">\n                    <i class=\"ti ti-settings text-lg\" data-kid=\"1-2-1-2-6-1\" data-name=\"settings icon\">\n                    </i>\n                </div>\n            </nav>\n            <div class=\"mt-auto opacity-40 hover:opacity-100 cursor-pointer\" data-kid=\"1-2-1-3\" data-name=\"logout link\">\n                <i class=\"ti ti-logout text-lg\" data-kid=\"1-2-1-3-1\" data-name=\"logout icon\">\n                </i>\n            </div>\n        </aside>\n        <!-- Main Content Area -->\n        <main class=\"flex-1 flex flex-col gap-3 min-w-0\" data-kid=\"1-2-2\" data-name=\"main content area\">\n            <!-- Command Bar Header -->\n            <header class=\"h-10 bg-white monolith-border flex items-center px-4 text-[10px] font-bold tracking-tight z-10\" data-kid=\"1-2-2-1\" data-name=\"header command bar\">\n                <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-1-1\" data-name=\"command mode indicator container\">\n                    <span class=\"font-fira opacity-40\" data-kid=\"1-2-2-1-1-1\" data-name=\"command mode text\">\n                        [CMD]\n                    </span>\n                    <span data-kid=\"1-2-2-1-1-2\" data-name=\"welcome message text\">\n                        مرحبا، المشرف\n                    </span>\n                </div>\n                <span class=\"mx-4 opacity-20\" data-kid=\"1-2-2-1-2\" data-name=\"separator\">\n                    |\n                </span>\n                <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-1-3\" data-name=\"security scope container\">\n                    <span class=\"opacity-50\" data-kid=\"1-2-2-1-3-1\" data-name=\"security scope label text\">\n                        النطاق الأمني:\n                    </span>\n                    <span class=\"bg-[var(--primary)] text-white px-1.5 py-0.5\" data-kid=\"1-2-2-1-3-2\" data-name=\"security level value\">\n                        LEVEL_04\n                    </span>\n                </div>\n                <span class=\"mx-4 opacity-20\" data-kid=\"1-2-2-1-4\" data-name=\"separator\">\n                    |\n                </span>\n                <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-1-5\" data-name=\"data sync status container\">\n                    <span class=\"opacity-50\" data-kid=\"1-2-2-1-5-1\" data-name=\"data sync label text\">\n                        مزامنة البيانات:\n                    </span>\n                    <span class=\"text-blue-600\" data-kid=\"1-2-2-1-5-2\" data-name=\"data sync status value\">\n                        نشط (100%)\n                    </span>\n                </div>\n                <span class=\"mx-4 opacity-20\" data-kid=\"1-2-2-1-6\" data-name=\"separator\">\n                    |\n                </span>\n                <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-1-7\" data-name=\"date display container\">\n                    <span class=\"opacity-50\" data-kid=\"1-2-2-1-7-1\" data-name=\"date label text\">\n                        الفترة:\n                    </span>\n                    <span class=\"font-fira\" data-kid=\"1-2-2-1-7-2\" data-name=\"date value text\">\n                        2023-11-22\n                    </span>\n                </div>\n                <div class=\"mr-auto flex items-center gap-6\" data-kid=\"1-2-2-1-8\" data-name=\"user settings and time area\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-1-8-1\" data-name=\"clock container\">\n                        <i class=\"ti ti-clock text-xs opacity-50\" data-kid=\"1-2-2-1-8-1-1\" data-name=\"clock icon\">\n                        </i>\n                        <span class=\"font-fira text-[9px] opacity-60\" data-kid=\"1-2-2-1-8-1-2\" data-name=\"clock time value text\">\n                            UTC+3 14:22:01\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-8-2\" data-name=\"header action icons\">\n                        <i class=\"ti ti-search text-base cursor-pointer hover:text-blue-600\" data-kid=\"1-2-2-1-8-2-1\" data-name=\"search icon\">\n                        </i>\n                        <i class=\"ti ti-bell text-base cursor-pointer hover:text-blue-600\" data-kid=\"1-2-2-1-8-2-2\" data-name=\"notification bell icon\">\n                        </i>\n                        <div class=\"w-6 h-6 monolith-border flex items-center justify-center overflow-hidden\" data-kid=\"1-2-2-1-8-2-3\" data-name=\"admin profile image container\">\n                            <img alt=\"Admin\" class=\"w-full h-full object-cover\" data-kid=\"1-2-2-1-8-2-3-1\" data-name=\"admin profile image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/100?u=admin\"/>\n                        </div>\n                    </div>\n                </div>\n            </header>\n            <!-- KPI Matrix (Stark Grid) -->\n            <section class=\"bg-white monolith-border overflow-hidden relative\" data-kid=\"1-2-2-2\" data-name=\"kpi metrics grid section\" id=\"kpi-matrix\">\n                <div class=\"coordinate-tag bottom-1 left-1\" data-kid=\"1-2-2-2-1\" data-name=\"grid reference tag\">\n                    REF: KPI_G1\n                </div>\n                <div class=\"bg-[var(--primary)] text-white px-3 py-1 text-[9px] font-bold uppercase tracking-widest flex justify-between\" data-kid=\"1-2-2-2-2\" data-name=\"grid section header\">\n                    <span data-kid=\"1-2-2-2-2-1\" data-name=\"grid title text\">\n                        System KPI Matrix [Grid_Ref: 01-04]\n                    </span>\n                    <span class=\"font-fira\" data-kid=\"1-2-2-2-2-2\" data-name=\"core version text\">\n                        INSTITUTIONAL_CORE_V2.0\n                    </span>\n                </div>\n                <div class=\"grid grid-cols-4 stark-grid divide-x divide-x-reverse divide-[var(--primary)]\" data-kid=\"1-2-2-2-3\" data-name=\"kpi data grid\">\n                    <!-- KPI 1 -->\n                    <div class=\"p-3 relative flex flex-col group overflow-hidden\" data-kid=\"1-2-2-2-3-1\" data-name=\"transaction volume kpi card\">\n                        <span class=\"absolute top-1 right-1 text-[8px] font-fira opacity-20\" data-kid=\"1-2-2-2-3-1-1\" data-name=\"card reference code\">\n                            A1\n                        </span>\n                        <span class=\"text-[9px] opacity-60 font-extrabold mb-0.5\" data-kid=\"1-2-2-2-3-1-2\" data-name=\"card title text\">\n                            إجمالي المعاملات اليومية\n                        </span>\n                        <div class=\"flex items-baseline gap-2 z-10\" data-kid=\"1-2-2-2-3-1-3\" data-name=\"card metric value container\">\n                            <span class=\"text-3xl font-bold font-fira tracking-tighter\" data-kid=\"1-2-2-2-3-1-3-1\" data-name=\"metric value number\">\n                                14,802\n                            </span>\n                            <span class=\"text-[9px] text-green-600 font-fira font-bold\" data-kid=\"1-2-2-2-3-1-3-2\" data-name=\"percentage change indicator\">\n                                ▲ 12%\n                            </span>\n                        </div>\n                        <div class=\"mt-1 h-0.5 w-full bg-gray-100 overflow-hidden z-10\" data-kid=\"1-2-2-2-3-1-4\" data-name=\"progress bar container\">\n                            <div class=\"h-full bg-blue-600 w-3/4\" data-kid=\"1-2-2-2-3-1-4-1\" data-name=\"progress bar fill\">\n                            </div>\n                        </div>\n                        <svg class=\"absolute bottom-0 left-0 w-full h-8 opacity-5 pointer-events-none\" data-kid=\"1-2-2-2-3-1-5\" data-name=\"trend line icon\" viewbox=\"0 0 100 20\">\n                            <polyline fill=\"none\" points=\"0,20 10,15 20,18 30,12 40,16 50,8 60,10 70,5 80,9 90,3 100,6\" stroke=\"currentColor\" stroke-width=\"1\">\n                            </polyline>\n                        </svg>\n                    </div>\n                    <!-- KPI 2 -->\n                    <div class=\"p-3 relative flex flex-col overflow-hidden\" data-kid=\"1-2-2-2-3-2\" data-name=\"response time kpi card\">\n                        <span class=\"absolute top-1 right-1 text-[8px] font-fira opacity-20\" data-kid=\"1-2-2-2-3-2-1\" data-name=\"card reference code\">\n                            A2\n                        </span>\n                        <span class=\"text-[9px] opacity-60 font-extrabold mb-0.5\" data-kid=\"1-2-2-2-3-2-2\" data-name=\"card title text\">\n                            متوسط زمن الاستجابة\n                        </span>\n                        <div class=\"flex items-baseline gap-2 z-10\" data-kid=\"1-2-2-2-3-2-3\" data-name=\"card metric value container\">\n                            <span class=\"text-3xl font-bold font-fira tracking-tighter\" data-kid=\"1-2-2-2-3-2-3-1\" data-name=\"metric value number\">\n                                0.42\n                            </span>\n                            <span class=\"text-[9px] opacity-40 font-fira\" data-kid=\"1-2-2-2-3-2-3-2\" data-name=\"unit text\">\n                                ms/req\n                            </span>\n                        </div>\n                        <div class=\"mt-1 h-0.5 w-full bg-gray-100 overflow-hidden z-10\" data-kid=\"1-2-2-2-3-2-4\" data-name=\"progress bar container\">\n                            <div class=\"h-full bg-[var(--primary)] w-1/2\" data-kid=\"1-2-2-2-3-2-4-1\" data-name=\"progress bar fill\">\n                            </div>\n                        </div>\n                    </div>\n                    <!-- KPI 3 -->\n                    <div class=\"p-3 relative flex flex-col overflow-hidden\" data-kid=\"1-2-2-2-3-3\" data-name=\"data accuracy kpi card\">\n                        <span class=\"absolute top-1 right-1 text-[8px] font-fira opacity-20\" data-kid=\"1-2-2-2-3-3-1\" data-name=\"card reference code\">\n                            A3\n                        </span>\n                        <span class=\"text-[9px] opacity-60 font-extrabold mb-0.5\" data-kid=\"1-2-2-2-3-3-2\" data-name=\"card title text\">\n                            دقة معالجة البيانات\n                        </span>\n                        <div class=\"flex items-baseline gap-2 z-10\" data-kid=\"1-2-2-2-3-3-3\" data-name=\"card metric value container\">\n                            <span class=\"text-3xl font-bold font-fira tracking-tighter\" data-kid=\"1-2-2-2-3-3-3-1\" data-name=\"metric value number\">\n                                99.98%\n                            </span>\n                        </div>\n                        <div class=\"mt-1 h-0.5 w-full bg-gray-100 overflow-hidden z-10\" data-kid=\"1-2-2-2-3-3-4\" data-name=\"progress bar container\">\n                            <div class=\"h-full bg-green-500 w-[99.98%]\" data-kid=\"1-2-2-2-3-3-4-1\" data-name=\"progress bar fill\">\n                            </div>\n                        </div>\n                    </div>\n                    <!-- KPI 4 -->\n                    <div class=\"p-3 relative flex flex-col overflow-hidden\" data-kid=\"1-2-2-2-3-4\" data-name=\"alerts kpi card\">\n                        <span class=\"absolute top-1 right-1 text-[8px] font-fira opacity-20\" data-kid=\"1-2-2-2-3-4-1\" data-name=\"card reference code\">\n                            A4\n                        </span>\n                        <span class=\"text-[9px] opacity-60 font-extrabold mb-0.5\" data-kid=\"1-2-2-2-3-4-2\" data-name=\"card title text\">\n                            التنبيهات الحرجة\n                        </span>\n                        <div class=\"flex items-baseline gap-2 z-10\" data-kid=\"1-2-2-2-3-4-3\" data-name=\"card metric value container\">\n                            <span class=\"text-3xl font-bold font-fira tracking-tighter text-red-600\" data-kid=\"1-2-2-2-3-4-3-1\" data-name=\"metric value number\">\n                                00\n                            </span>\n                            <span class=\"text-[9px] opacity-40 font-fira\" data-kid=\"1-2-2-2-3-4-3-2\" data-name=\"status text\">\n                                ACTIVE\n                            </span>\n                        </div>\n                        <div class=\"mt-1 h-0.5 w-full bg-gray-100 overflow-hidden z-10\" data-kid=\"1-2-2-2-3-4-4\" data-name=\"progress bar container\">\n                            <div class=\"h-full bg-red-600 w-0\" data-kid=\"1-2-2-2-3-4-4-1\" data-name=\"progress bar fill\">\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </section>\n            <!-- Middle Data Section -->\n            <div class=\"grid grid-cols-12 gap-3 h-[280px]\" data-kid=\"1-2-2-3\" data-name=\"analytics and resource status section\">\n                <!-- Analytics Section -->\n                <section class=\"col-span-8 bg-white monolith-border 