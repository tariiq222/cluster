    "var_8e789faa0ab2": {
      "type": "variant",
      "label": "Institutional Clarity: Color-Blocked Clinical",
      "parentId": "var_179ba27de628",
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&family=Oswald:wght@300;500;700&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    :root {\n        --deep-navy: #112236;\n        --cool-gray: #EAECEF;\n        --activity-gray: #F0F3F5;\n        --accent-blue: #005C8A;\n        --accent-green: #1E8155;\n    }\n\n    body {\n        margin: 0;\n        padding: 0;\n        background-color: var(--deep-navy);\n        font-family: 'Tajawal', sans-serif;\n        color: var(--deep-navy);\n        overflow-x: clip;\n    }\n\n    .font-numbers {\n        font-family: 'Oswald', sans-serif;\n    }\n\n    .l-frame {\n        display: grid;\n        grid-template-columns: 100px 1fr;\n        min-height: 100vh;\n    }\n\n    .sidebar {\n        background-color: var(--deep-navy);\n        display: flex;\n        flex-direction: column;\n        align-items: center;\n        padding-top: 2.5rem;\n        gap: 2.5rem;\n        border-left: 1px solid rgba(255, 255, 255, 0.1);\n        z-index: 50;\n    }\n\n    .main-canvas {\n        background-color: var(--deep-navy);\n        position: relative;\n    }\n\n    .content-container {\n        background-color: #FFFFFF;\n        margin-top: 140px;\n        border-radius: 0 100px 0 0;\n        min-height: calc(100vh - 140px);\n        box-shadow: -30px -30px 80px rgba(0,0,0,0.18);\n        position: relative;\n        z-index: 10;\n        overflow: hidden;\n    }\n\n    .zebra-row:nth-child(even) {\n        background-color: #F0F3F5;\n    }\n\n    .zebra-row:hover {\n        background-color: #FFFFFF;\n        box-shadow: inset 0 0 0 1px rgba(17, 34, 54, 0.05);\n    }\n\n    /* Custom chunky scrollbar */\n    ::-webkit-scrollbar {\n        width: 10px;\n    }\n    ::-webkit-scrollbar-track {\n        background: var(--cool-gray);\n    }\n    ::-webkit-scrollbar-thumb {\n        background: var(--deep-navy);\n    }\n\n    .chunky-bar-container {\n        height: 56px;\n        background-color: #DDE2E6;\n        position: relative;\n    }\n\n    .chunky-bar-fill {\n        height: 100%;\n        background-color: var(--deep-navy);\n    }\n</style>\n<link data-kid=\"1\" data-name=\"lenis scroll library stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" rel=\"stylesheet\"/>\n<div class=\"l-frame\" data-kid=\"2\" data-name=\"page frame container\" dir=\"rtl\">\n    <!-- Sidebar -->\n    <aside class=\"sidebar h-screen sticky top-0\" data-kid=\"2-1\" data-name=\"sidebar navigation\">\n        <div class=\"w-14 h-14 bg-white/10 rounded-2xl flex items-center justify-center text-white mb-10 ring-1 ring-white/20\" data-kid=\"2-1-1\" data-name=\"hospital building icon container\">\n            <i class=\"ti ti-building-hospital text-3xl\" data-kid=\"2-1-1-1\" data-name=\"hospital building icon\">\n            </i>\n        </div>\n        <nav class=\"flex flex-col gap-8\" data-kid=\"2-1-2\" data-name=\"navigation link group\">\n            <a class=\"w-12 h-12 flex items-center justify-center text-white bg-white/5 rounded-lg text-2xl\" data-kid=\"2-1-2-1\" data-name=\"active dashboard home link\" href=\"#\">\n                <i class=\"ti ti-smart-home\" data-kid=\"2-1-2-1-1\" data-name=\"home icon\">\n                </i>\n            </a>\n            <a class=\"w-12 h-12 flex items-center justify-center text-white/40 hover:text-white hover:bg-white/5 transition-all duration-300 rounded-lg text-2xl\" data-kid=\"2-1-2-2\" data-name=\"users management link\" href=\"#\">\n                <i class=\"ti ti-users\" data-kid=\"2-1-2-2-1\" data-name=\"users group icon\">\n                </i>\n            </a>\n            <a class=\"w-12 h-12 flex items-center justify-center text-white/40 hover:text-white hover:bg-white/5 transition-all duration-300 rounded-lg text-2xl\" data-kid=\"2-1-2-3\" data-name=\"analytics reports link\" href=\"#\">\n                <i class=\"ti ti-chart-bar\" data-kid=\"2-1-2-3-1\" data-name=\"chart bar icon\">\n                </i>\n            </a>\n            <a class=\"w-12 h-12 flex items-center justify-center text-white/40 hover:text-white hover:bg-white/5 transition-all duration-300 rounded-lg text-2xl\" data-kid=\"2-1-2-4\" data-name=\"settings page link\" href=\"#\">\n                <i class=\"ti ti-settings\" data-kid=\"2-1-2-4-1\" data-name=\"settings gear icon\">\n                </i>\n            </a>\n        </nav>\n    </aside>\n    <!-- Main Section -->\n    <main class=\"main-canvas\" data-kid=\"2-2\" data-name=\"main canvas content area\">\n        <!-- Header Content (Floating on Navy) -->\n        <div class=\"absolute top-0 left-0 right-0 h-[140px] flex items-center justify-between px-16 z-0\" data-kid=\"2-2-1\" data-name=\"header information bar\">\n            <div data-kid=\"2-2-1-1\" data-name=\"page title and status container\">\n                <h1 class=\"text-4xl font-bold text-white mb-1\" data-kid=\"2-2-1-1-1\" data-name=\"page title heading\">\n                    لوحة التحكم المؤسسية\n                </h1>\n                <div class=\"flex items-center gap-3\" data-kid=\"2-2-1-1-2\" data-name=\"status tags container\">\n                    <span class=\"px-3 py-1 bg-white/10 text-white/80 rounded-full text-xs font-medium border border-white/20\" data-kid=\"2-2-1-1-2-1\" data-name=\"sector status tag\">\n                        القطاع الطبي الشمالي\n                    </span>\n                    <span class=\"flex items-center gap-1 text-green-400 text-xs\" data-kid=\"2-2-1-1-2-2\" data-name=\"system status tag\">\n                        <span class=\"w-2 h-2 bg-green-400 rounded-full animate-pulse\" data-kid=\"2-2-1-1-2-2-1\" data-name=\"system status pulse indicator\">\n                        </span>\n                        النظام متاح\n                    </span>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-6\" data-kid=\"2-2-1-2\" data-name=\"user profile and time container\">\n                <div class=\"text-left text-white/60\" data-kid=\"2-2-1-2-1\" data-name=\"last update timestamp container\">\n                    <p class=\"text-xs\" data-kid=\"2-2-1-2-1-1\" data-name=\"last update text label\">\n                        آخر تحديث\n                    </p>\n                    <p class=\"font-numbers text-sm font-medium text-white\" data-kid=\"2-2-1-2-1-2\" data-name=\"last update timestamp display\">\n                        14:30:05\n                    </p>\n                </div>\n                <div class=\"w-12 h-12 rounded-full overflow-hidden border-2 border-white/20\" data-kid=\"2-2-1-2-2\" data-name=\"admin profile image container\">\n                    <img alt=\"Admin\" data-kid=\"2-2-1-2-2-1\" data-name=\"admin profile image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/100?u=admin\"/>\n                </div>\n            </div>\n        </div>\n        <!-- Content Shell -->\n        <div class=\"content-container rtl-round\" data-kid=\"2-2-2\" data-name=\"content shell container\">\n            <!-- 1. Overview KPIs (White Band) -->\n            <section class=\"p-16 grid grid-cols-2 lg:grid-cols-4 gap-12 bg-white\" data-kid=\"2-2-2-1\" data-name=\"kpi overview section\">\n                <div class=\"kpi-block flex items-start gap-4 border-l border-slate-100 pl-4 last:border-0\" data-kid=\"2-2-2-1-1\" data-name=\"total cases kpi block\">\n                    <div class=\"text-8xl font-bold font-numbers tracking-tighter leading-none text-[var(--deep-navy)]\" data-kid=\"2-2-2-1-1-1\" data-name=\"total cases number\">\n                        1.2k\n                    </div>\n                    <div class=\"mt-2\" data-kid=\"2-2-2-1-1-2\" data-name=\"total cases label group\">\n                        <p class=\"text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400 mb-1\" data-kid=\"2-2-2-1-1-2-1\" data-name=\"total cases category label\">\n                            إجمالي\n                        </p>\n                        <p class=\"text-xl font-bold text-[var(--deep-navy)]\" data-kid=\"2-2-2-1-1-2-2\" data-name=\"total cases metric title\">\n                            الحالات\n                        </p>\n                    </div>\n                </div>\n                <div class=\"kpi-block flex items-start gap-4 border-l border-slate-100 pl-4 last:border-0\" data-kid=\"2-2-2-1-2\" data-name=\"daily operations kpi block\">\n                    <div class=\"text-8xl font-bold font-numbers tracking-tighter leading-none text-[var(--deep-navy)]\" data-kid=\"2-2-2-1-2-1\" data-name=\"daily operations number\">\n                        42\n                    </div>\n                    <div class=\"mt-2\" data-kid=\"2-2-2-1-2-2\" data-name=\"daily operations label group\">\n                        <p class=\"text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400 mb-1\" data-kid=\"2-2-2-1-2-2-1\" data-name=\"daily operations category label\">\n                            اليوم\n                        </p>\n                        <p class=\"text-xl font-bold text-[var(--deep-navy)]\" data-kid=\"2-2-2-1-2-2-2\" data-name=\"daily operations metric title\">\n                            عمليات\n                        </p>\n                    </div>\n                </div>\n                <div class=\"kpi-block flex items-start gap-4 border-l border-slate-100 pl-4 last:border-0\" data-kid=\"2-2-2-1-3\" data-name=\"recovery rate kpi block\">\n                    <div class=\"text-8xl font-bold font-numbers tracking-tighter leading-none text-[var(--accent-green)]\" data-kid=\"2-2-2-1-3-1\" data-name=\"recovery rate percentage\">\n                        89%\n                    </div>\n                    <div class=\"mt-2\" data-kid=\"2-2-2-1-3-2\" data-name=\"recovery rate label group\">\n                        <p class=\"text-[10px] font-bold uppercase tracking-[0.2em] t