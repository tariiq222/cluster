n                    <!-- Right: Quick Stats Block -->\n                    <div class=\"xl:col-span-4 flex flex-col justify-center pr-16\" data-kid=\"2-2-2-2-2-3\" data-name=\"quick stats block\">\n                        <div class=\"mb-10\" data-kid=\"2-2-2-2-2-3-1\" data-name=\"pending orders block\">\n                            <p class=\"text-sm font-bold text-slate-500 mb-2 uppercase tracking-widest\" data-kid=\"2-2-2-2-2-3-1-1\" data-name=\"pending orders label\">\n                                إجمالي الطلبات المعلقة\n                            </p>\n                            <h3 class=\"text-8xl font-bold font-numbers text-[var(--deep-navy)] leading-none tracking-tighter\" data-kid=\"2-2-2-2-2-3-1-2\" data-name=\"pending orders total\">\n                                2,482\n                            </h3>\n                            <p class=\"text-sm mt-4 flex items-center gap-2 text-red-600 font-bold\" data-kid=\"2-2-2-2-2-3-1-3\" data-name=\"pending orders trend\">\n                                <span class=\"px-2 py-0.5 bg-red-100 font-numbers rounded-sm\" data-kid=\"2-2-2-2-2-3-1-3-1\" data-name=\"pending orders growth rate\">\n                                    +12.4%\n                                </span>\n                                <span class=\"text-xs\" data-kid=\"2-2-2-2-2-3-1-3-2\" data-name=\"pending orders comparison\">\n                                    عن الأسبوع الماضي\n                                </span>\n                            </p>\n                        </div>\n                        <div class=\"p-10 bg-white shadow-2xl shadow-black/10 border-r-8 border-[var(--deep-navy)]\" data-kid=\"2-2-2-2-2-3-2\" data-name=\"system notification card\">\n                            <p class=\"text-base italic text-slate-700 leading-loose\" data-kid=\"2-2-2-2-2-3-2-1\" data-name=\"notification text quote\">\n                                \"النتائج الحالية تشير إلى زيادة ملحوظة في ضغط الحالات بقسم الطوارئ. يرجى توجي