{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cluster.example/schemas/problem-details.schema.json",
  "title": "Problem Details",
  "type": "object",
  "additionalProperties": true,
  "required": ["type", "title", "status"],
  "properties": {
    "type": {"type": "string", "format": "uri-reference"},
    "title": {"type": "string"},
    "status": {"type": "integer", "minimum": 100, "maximum": 599},
    "detail": {"type": "string"},
    "instance": {"type": "string", "format": "uri-reference"},
    "correlation_id": {"$ref": "#/$defs/uuidv7"},
    "errors": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["pointer", "code"], "properties": {"pointer": {"type": "string"}, "code": {"type": "string"}, "message": {"type": "string"}}}}
  },
  "$defs": {"uuidv7": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "description": "Lowercase RFC 9562 UUID version 7"}}
}
