{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cluster.example/schemas/com-cluster-documents-grantissued-v1.schema.json",
  "title": "Outbox event: com.cluster.documents.grantissued.v1",
  "description": "CloudEvents envelope for a one-time document grant issuance.",
  "type": "object",
  "additionalProperties": true,
  "required": ["data"],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "version_id", "grant_type", "correlation_id", "actor_user_id"],
      "properties": {
        "document_id": {"type": "string"},
        "version_id": {"type": "string"},
        "grant_type": {"type": "string", "enum": ["preview", "download"]},
        "correlation_id": {"type": "string"},
        "actor_user_id": {"type": "string"}
      }
    }
  }
}
