{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cluster.example/schemas/user-account-changed.schema.json",
  "title": "User Account Changed Event Data",
  "type": "object",
  "additionalProperties": false,
  "required": ["account_id", "person_id", "person_version", "status", "action", "lock_version", "access_context", "classification"],
  "properties": {
    "account_id": {"$ref": "#/$defs/uuidv7"},
    "person_id": {"$ref": "#/$defs/uuidv7"},
    "person_version": {"type": "integer", "minimum": 1},
    "status": {"type": "string", "enum": ["pending", "active", "locked", "disabled", "archived"]},
    "action": {"type": "string", "enum": ["create", "activate", "unlock", "disable", "archive", "revoke-sessions", "force-password-change", "reconcile-person"]},
    "lock_version": {"type": "integer", "minimum": 1},
    "access_context": {"$ref": "access-context.schema.json"},
    "classification": {"const": "confidential"}
  },
  "$defs": {
    "uuidv7": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}
  }
}
