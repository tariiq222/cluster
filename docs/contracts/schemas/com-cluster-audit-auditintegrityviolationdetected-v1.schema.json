{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cluster.example/schemas/com-cluster-audit-auditintegrityviolationdetected-v1.schema.json",
  "title": "Outbox event: com.cluster.audit.auditintegrityviolationdetected.v1",
  "description": "CloudEvents envelope for a bounded Audit integrity verification that surfaced a hash-chain mismatch. Mirrors the exact payload emitted by apps/api/Modules/Audit/Events/AuditIntegrityViolationDetectedV1.php::payload().",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "data"
  ],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "verification_id",
        "stream_key",
        "correlation_id",
        "first_mismatch_stream_sequence",
        "verified_event_count",
        "integrity_status",
        "detected_at"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "verification_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "stream_key": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^[a-z][a-z0-9_-]*:[a-z][a-z0-9_-]*:(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|global)$"
        },
        "correlation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "first_mismatch_stream_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "verified_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "integrity_status": {
          "type": "string",
          "enum": [
            "violated"
          ]
        },
        "detected_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        }
      }
    }
  }
}
