{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cluster.example/schemas/person-access-status-changed.schema.json",
  "title": "Person Access Status Changed Event Data",
  "type": "object",
  "additionalProperties": false,
  "required": ["person_id", "person_version", "access_status", "access_context", "classification"],
  "properties": {
    "person_id": {"$ref": "#/$defs/uuidv7"},
    "person_version": {"type": "integer", "minimum": 1},
    "access_status": {"type": "string", "enum": ["active", "suspended", "left"]},
    "access_context": {"$ref": "access-context.schema.json"},
    "classification": {"const": "confidential"}
  },
  "$defs": {
    "uuidv7": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}
  }
}
