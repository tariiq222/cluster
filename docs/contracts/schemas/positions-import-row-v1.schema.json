{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cluster.example/schemas/positions-import-row-v1.schema.json",
  "title": "Positions Import Row v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["organization_unit_id", "code", "title"],
  "properties": {
    "organization_unit_id": {"$ref": "#/$defs/uuidv7"},
    "code": {"type": "string", "pattern": "^[A-Z0-9_-]{2,64}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 255},
    "manager_position_id": {
      "oneOf": [
        {"$ref": "#/$defs/uuidv7"},
        {"type": "null"}
      ]
    }
  },
  "$defs": {
    "uuidv7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
