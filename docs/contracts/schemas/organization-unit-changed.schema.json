{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cluster.example/schemas/organization-unit-changed.schema.json",
  "title": "Organization Unit Changed Event Data",
  "type": "object",
  "additionalProperties": false,
  "required": ["organization_unit", "access_context", "classification"],
  "properties": {
    "organization_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cluster_id", "parent_id", "parent_type", "type_code", "code", "name_ar", "name_en", "status", "path_cache", "depth", "lock_version"],
      "properties": {
        "id": {"$ref": "#/$defs/uuidv7"},
        "cluster_id": {"$ref": "#/$defs/uuidv7"},
        "parent_id": {"$ref": "#/$defs/uuidv7"},
        "parent_type": {"type": "string", "enum": ["cluster", "facility", "unit"]},
        "type_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "code": {"type": "string", "pattern": "^[A-Z0-9_-]{2,64}$"},
        "name_ar": {"type": "string", "minLength": 1, "maxLength": 255},
        "name_en": {"type": ["string", "null"], "maxLength": 255},
        "status": {"type": "string", "enum": ["active", "inactive", "archived"]},
        "path_cache": {"type": "string", "minLength": 38, "maxLength": 512},
        "depth": {"type": "integer", "minimum": 1},
        "lock_version": {"type": "integer", "minimum": 1}
      }
    },
    "previous_parent_id": {"$ref": "#/$defs/uuidv7"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
    "access_context": {"$ref": "access-context.schema.json"},
    "classification": {"const": "internal"}
  },
  "$defs": {
    "uuidv7": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}
  }
}
