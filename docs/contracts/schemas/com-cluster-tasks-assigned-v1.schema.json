{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cluster.example/schemas/com-cluster-tasks-assigned-v1.schema.json",
  "title": "Outbox event: com.cluster.tasks.assigned.v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["data"],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "title", "actor_user_id", "assignee_user_id", "previous_assignee_user_id"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "actor_user_id": {"type": "string", "minLength": 1},
        "assignee_user_id": {"type": "string", "minLength": 1},
        "previous_assignee_user_id": {"type": ["string", "null"]}
      }
    }
  }
}
