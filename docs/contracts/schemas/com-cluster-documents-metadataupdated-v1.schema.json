{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cluster.example/schemas/com-cluster-documents-metadataupdated-v1.schema.json",
  "title": "Outbox event: com.cluster.documents.metadataupdated.v1",
  "description": "CloudEvents envelope for a governed document metadata update.",
  "type": "object",
  "additionalProperties": true,
  "required": ["data"],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "changed_fields", "correlation_id", "actor_user_id"],
      "properties": {
        "document_id": {"type": "string"},
        "changed_fields": {"type": "array", "items": {"type": "string"}},
        "classification_change_reason": {"type": ["string", "null"]},
        "correlation_id": {"type": "string"},
        "actor_user_id": {"type": "string"}
      }
    }
  }
}
