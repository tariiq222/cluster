{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cluster.example/schemas/com-cluster-audit-auditexportcompleted-v1.schema.json",
  "title": "Outbox event: com.cluster.audit.auditexportcompleted.v1",
  "description": "CloudEvents envelope for the Audit export completion in POST /api/v1/audit/exports. Mirrors the exact payload emitted by apps/api/Modules/Audit/Events/AuditExportCompletedV1.php::payload(). Emitted exactly once per successful export-descriptor creation; contains no export bytes or download outcome.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "data"
  ],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "export_id",
        "principal_id",
        "facility_id",
        "format",
        "event_count",
        "correlation_id",
        "completed_at"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "export_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "principal_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "facility_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "format": {
          "type": "string",
          "enum": [
            "csv",
            "ndjson"
          ]
        },
        "event_count": {
          "type": "integer",
          "minimum": 0
        },
        "correlation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        }
      }
    }
  }
}
