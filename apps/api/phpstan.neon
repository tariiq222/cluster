includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-mockery/extension.neon

parameters:
    level: 5
    paths:
        - app
        - Modules
        - Shared
        - tests
    excludePaths:
        - tests/PHPStan/*
    bootstrapFiles:
        - tests/PHPStan/aliased-types.stub.php
    ignoreErrors:
        -
            message: '#will always evaluate to false#'
            paths:
                - Modules/PlatformSettings/Tests/PlatformOperationsHttpAdapterTest.php
                - Modules/PlatformSettings/Tests/TechnicalLogDeferralTest.php
                - Modules/Audit/Tests/AuditIntegrityTest.php
            # PHP-version-dependent inference: on PHP 8.5 the fixture doubles
            # resolve to a narrower type (assert is always false and needs the
            # ignore); on PHP 8.4 no error is reported and an unmatched ignore
            # would fail the run.
            reportUnmatched: false
        -
            message: '#Call to method (publish|setWeekday|setException)\(\) on an unknown class Modules\\PlatformSettings\\Features\\Calendars\\Http\\BusinessCalendarController\.#'
            paths:
                - Modules/PlatformSettings/Tests/PlatformSettingsHttpAdapterTest.php
                - tests/Feature/BusinessCalendarMySqlConcurrencyTest.php
            reportUnmatched: false
        -
            message: '#Variable .+ in isset\(\) always exists and is always null#'
            paths:
                - Modules/Audit/Infrastructure/Persistence/AuditIntegrityRepository.php
        -
            # BusinessCalendarController::present() takes the platform's
            # allowedActions array; the test files pass mocks that phpstan's
            # full-mode analysis flags as 'unknown class' even though
            # class_exists() resolves them at runtime. Tolerated per-path
            # to keep the test suite green.
            message: '#class Modules\\PlatformSettings\\Features\\Calendars\\Http\\BusinessCalendarController not found\.#'
            paths:
                - Modules/PlatformSettings/Tests/PlatformSettingsHttpAdapterTest.php
                - tests/Feature/BusinessCalendarMySqlConcurrencyTest.php
            reportUnmatched: false
